{
  "name": "lisan-arabic-lang",
  "displayName": "Lisan (لسان) - لغة البرمجة العربية",
  "description": "دعم التلوين النحوي وإعدادات المحرر للغة البرمجة العربية لسان (.lsn)",
  "version": "1.0.0",
  "publisher": "lisan-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lisan",
        "aliases": [
          "Lisan",
          "لسان",
