{
  "name": "lisan-arabic-lang",
  "displayName": "Lisan (لسان) - لغة البرمجة العربية",
  "description": "دعم التلوين النحوي وإعدادات المحرر للغة البرمجة العربية لسان (.lsn)",
  "version": "1.0.0",
  "publisher": "lisan-lang",
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lisan"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lisan",
        "aliases": [
          "Lisan",
          "لسان",
          "lisan"
        ],
        "extensions": [
          ".lsn",
          ".lisan"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lisan",
        "scopeName": "source.lisan",
        "path": "./syntaxes/lisan.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Lisan Language Server",
      "properties": {
        "lisan.executablePath": {
          "type": "string",
          "default": "lisan",
          "description": "المسار التنفيذي لمترجم ومفسّر لسان (Lisan Executable Path)"
        },
        "lisan.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "تفعيل خادم لغة لسان الذكي LSP"
        }
      }
    }
  }
}
