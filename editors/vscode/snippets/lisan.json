{
  "دالة": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:اسم_الدالة}(${2:معامل}) {",
      "    ${3:أرجع معامل}",
      "}"
    ],
    "description": "تعريف دالة عربية جديدة"
  },
  "دالة_نوع": {
    "prefix": "دالة_نوع",
    "body": [
      "دالة ${1:حساب}(${2:قيمة}: ${3|عدد,نص,منطقي,قائمة,قاموس,أي|}) -> ${4|عدد,نص,منطقي,قائمة,قاموس,فارغ,أي|} {",
      "    ${5:أرجع قيمة}",
      "}"
    ],
    "description": "تعريف دالة مع توصيف الأنواع التدريجية (عدد / نص / منطقي / قائمة / قاموس)"
  },
  "صنف": {
    "prefix": "صنف",
    "body": [
      "صنف ${1:اسم_الصنف} {",
      "    دالة بناء(${2:الاسم}) {",
      "        هذا.${2:الاسم} = ${2:الاسم}",
      "    }",
      "",
      "    دالة ${3:وصف}() {",
      "        أرجع ن\"{هذا.${2:الاسم}}\"",
      "    }",
      "}"
    ],
    "description": "تعريف صنف كائني مع دالة بناء وطريقة"
  },
  "إذا": {
    "prefix": "إذا",
    "body": [
      "إذا (${1:الشرط}) {",
      "    ${2:اطبع(\"تحقق الشرط\")}",
      "} وإلا {",
      "    ${3:اطبع(\"لم يتحقق الشرط\")}",
      "}"
    ],
    "description": "جملة شرطية (إذا / وإلا)"
  },
  "لكل": {
    "prefix": "لكل",
    "body": [
      "لكل ${1:عنصر} في ${2:مدى(10)} {",
      "    ${3:اطبع(عنصر)}",
      "}"
    ],
    "description": "حلقة تكرار تمر على عناصر قائمة أو مدى"
  },
  "طالما": {
    "prefix": "طالما",
    "body": [
      "دع ${1:العداد} = 0",
      "طالما (${1:العداد} < ${2:10}) {",
      "    ${3:اطبع(العداد)}",
      "    ${1:العداد} = ${1:العداد} + 1",
      "}"
    ],
    "description": "حلقة تكرار شرطية (طالما)"
  },
  "حاول": {
    "prefix": "حاول",
    "body": [
      "حاول {",
      "    ${1:# الشيفرة المحتمل حدوث خطأ بها}",
      "} التقط ${2:خطأ_التنفيذ} {",
      "    اطبع(ن\"حدث خطأ: {${2:خطأ_التنفيذ}}\")",
      "} أخيرًا {",
      "    ${3:# تنظيف الموارد}",
      "}"
    ],
    "description": "معالجة الاستثناءات والأخطاء (حاول / التقط / أخيرًا)"
  },
  "اختر": {
    "prefix": "اختر",
    "body": [
      "اختر (${1:القيمة}) {",
      "    حالة ${2:\"أول\"}:",
      "        ${3:اطبع(\"الخيار الأول\")}",
      "    حالة ${4:\"ثانٍ\"}:",
      "        ${5:اطبع(\"الخيار الثاني\")}",
      "    افتراضي:",
      "        ${6:اطبع(\"خيار افتراضي\")}",
      "}"
    ],
    "description": "مطابقة الأنماط المتعددة (اختر / حالة / افتراضي)"
  },
  "تطبيق_ويب": {
    "prefix": "تطبيق_ويب",
    "body": [
      "استورد \"إطار_ويب\"",
      "",
      "دع خادم = جديد تطبيق_ويب(\"${1:بوابة_لسان}\"، ${2:8080})",
      "خادم.مسار_get(\"/\"، \"<h1>أهلاً بك في تطبيق لسان</h1>\")",
      "خادم.رد_json(\"/واجهة/حالة\"، {\"حالة\": \"يعمل\"، \"الإصدار\": \"1.2.0\"})",
      "اطبع(\"تطبيق الويب جاهز على المنفذ ${2:8080}\")"
    ],
    "description": "إنشاء خادم وتطبيق ويب متعدد المسارات باستخدام إطار_ويب"
  },
  "تطبيق_هاتف": {
    "prefix": "تطبيق_هاتف",
    "body": [
      "استورد \"هاتف\"",
      "",
      "دع تطبيق = جديد تطبيق_هاتف(\"${1:تطبيقي_العربي}\"، \"${2|زمردي,ملكي,غروب,ليلي|}\")",
      "تطبيق.أضف_إحصائية(\"المهام\"، \"12\"، \"نجمة\")",
      "تطبيق.أضف_بطاقة(\"${3:مرحباً بك}\"، \"${4:تطبيق هاتف ذكي مكتوب بلغة لسان}\"، \"هاتف\")",
      "تطبيق.أضف_زر(\"${5:ابدأ الآن}\"، \"برق\"، \"تم تفعيل الإجراء بنجاح\")",
      "اطبع(تطبيق.بناء_واجهة())"
    ],
    "description": "بناء وتصدير تطبيق هاتف ذكي تقدمي (PWA)"
  },
  "موقع_ويب": {
    "prefix": "موقع_ويب",
    "body": [
      "استورد \"موقع\"",
      "",
      "دع موقع = جديد موقع_ويب(\"${1:موقعي_العربي}\"، \"${2|ملكي,زمردي,غروب,ليلي|}\")",
      "موقع.شريط_تنقل(\"${1:موقعي_العربي}\")",
      "موقع.قسم_رئيسي(\"${3:أهلاً بك في لسان}\"، \"${4:موقع عربي متجاوب مبني بالكامل بلغة لسان}\"، \"استكشف الآن\"، \"شمس\")",
      "موقع.أضف_بطاقة(\"سريع\"، \"أداء عالٍ وبناء فوري\"، \"برق\")",
      "موقع.أضف_تذييل()",
      "اطبع(موقع.بناء_html())"
    ],
    "description": "بناء موقع ويب عربي متجاوب وحديث"
  },
  "مكتبة_بايثون": {
    "prefix": "مكتبة_بايثون",
    "body": [
      "# وحدة لسان قابلة للترجمة إلى بايثون 3",
      "دالة ${1:احسب_المتوسط}(قائمة_الأرقام: قائمة) -> عدد {",
      "    إذا (طول(قائمة_الأرقام) == 0) {",
      "        أرجع 0",
      "    }",
      "    أرجع مجموع(قائمة_الأرقام) / طول(قائمة_الأرقام)",
      "}",
      "",
      "دع بيانات = [10، 20، 30، 40]",
      "اطبع(ن\"المتوسط الحسابي = {${1:احسب_المتوسط}(بيانات)}\")"
    ],
    "description": "قالب وحدة برمجية عربية نظيفة للترجمة إلى بايثون"
  },
  "نموذج_ذكاء": {
    "prefix": "نموذج_ذكاء",
    "body": [
      "استورد \"ذكاء\"",
      "",
      "دع نموذج = جديد انحدار_خطي()",
      "دع س = [1، 2، 3، 4، 5]",
      "دع ص = [3، 5، 7، 9، 11]",
      "نموذج.درّب(س، ص)",
      "دع توقع = نموذج.توقّع(${1:6})",
      "اطبع(ن\"التوقّع عند ${1:6} هو: {توقع}\")"
    ],
    "description": "نموذج تعلم آلي بالانحدار الخطي من وحدة ذكاء"
  },
  "شبكة_عصبية": {
    "prefix": "شبكة_عصبية",
    "body": [
      "استورد \"ذكاء\"",
      "",
      "دع شبكة = جديد شبكة_عصبية(${1:2}، ${2:4}، ${3:0.5})",
      "دع مدخلات = [[0، 0]، [0، 1]، [1، 0]، [1، 1]]",
      "دع أهداف = [0، 1، 1، 0]",
      "شبكة.درّب(مدخلات، أهداف، ${4:500})",
      "اطبع(ن\"نتيجة التوقّع لـ [1، 0]: {شبكة.توقّع([1، 0])}\")"
    ],
    "description": "بناء وتدريب شبكة عصبية اصطناعية بالانتشار العكسي"
  },
  "أردوينو": {
    "prefix": "أردوينو",
    "body": [
      "استورد \"اردوينو\"",
      "",
      "دع حساس = جديد حساس_حرارة(${1:2})",
      "دع مرحل = جديد مرحل_كهربائي(${2:8})",
      "دع درجة = حساس.اقرأ_حرارة()",
      "إذا (درجة > ${3:30}) {",
      "    مرحل.تشغيل()",
      "    اطبع(\"تم تشغيل التبريد تلقائياً\")",
      "} وإلا {",
      "    مرحل.إيقاف()",
      "}"
    ],
    "description": "قالب برنامج أردوينو لقراءة الحساسات والتحكم بالمرحلات"
  },
  "بيكو": {
    "prefix": "بيكو",
    "body": [
      "استورد \"بيكو\"",
      "",
      "دع لوحة = جديد لوحة_بيكو(\"${1:Pico W}\")",
      "دع مصباح = جديد منفذ_بيكو(${2:25}، \"خرج\")",
      "مصباح.تشغيل()",
      "دع حرارة = جديد مستشعر_حرارة_داخلي_بيكو()",
      "اطبع(ن\"حرارة شريحة بيكو: {حرارة.اقرأ_مئوية()} م°\")"
    ],
    "description": "قالب برنامج راسبيري باي بيكو (RP2040 / Pico W)"
  },
  "راسبيري": {
    "prefix": "راسبيري",
    "body": [
      "استورد \"راسبيري\"",
      "",
      "دع لوحة = جديد لوحة_راسبيري(\"${1:Raspberry Pi 5}\")",
      "دع منفذ = جديد منفذ_gpio_راسبيري(${2:17}، \"خرج\")",
      "منفذ.تشغيل()",
      "اطبع(ن\"حرارة المعالج: {لوحة.حرارة_المعالج()}\")"
    ],
    "description": "قالب برنامج حاسوب راسبيري باي مع منافذ GPIO"
  },
  "متحكم_تناسبي_تكاملي": {
    "prefix": "متحكم_تناسبي_تكاملي",
    "body": [
      "استورد \"روبوتات\"",
      "",
      "دع متحكم = جديد متحكم_pid(${1:1.2}، ${2:0.1}، ${3:0.05}، ${4:100})",
      "دع القراءة = ${5:75}",
      "دع إشارة_التحكم = متحكم.احسب(القراءة، 0.1)",
      "اطبع(ن\"مخرج المتحكم التناسبي التكاملي التفاضلي: {إشارة_التحكم}\")"
    ],
    "description": "متحكم تناسبي تكاملي تفاضلي (PID) للروبوتات والتحكم الآلي"
  },
  "لعبة": {
    "prefix": "لعبة",
    "body": [
      "استورد \"ألعاب\"",
      "",
      "دع لعبتي = جديد لعبة_ثنائية_الأبعاد(\"${1:مغامرة_لسان}\"، 800، 500)",
      "لعبتي.أضف_لاعب(\"${2:البطل}\"، 100، 250، 40، 40، \"#e65c1a\"، 6)",
      "لعبتي.أضف_هدف(\"جوهرة\"، \"#10b981\"، 10)",
      "لعبتي.أضف_عقبة(\"نيزك\"، \"#ef4444\"، 4)",
      "لعبتي.اضبط_تحكم(\"أسهم_ولمس\")",
      "اطبع(لعبتي.بناء_لعبة_html())"
    ],
    "description": "بناء لعبة ثنائية الأبعاد عربية متكاملة"
  },
  "اختبار": {
    "prefix": "اختبار",
    "body": [
      "# حزمة اختبارات وحدة لسان",
      "دالة اختبار_${1:الميزة}() {",
      "    دع النتيجة = ${2:2 + 2}",
      "    تحقق_يساوي(النتيجة، ${3:4})",
      "    تحقق(النتيجة > 0)",
      "    اطبع(\"✓ نجح اختبار ${1:الميزة}\")",
      "}",
      "",
      "اختبار_${1:الميزة}()"
    ],
    "description": "إنشاء اختبار وحدة باستخدام تحقق و تحقق_يساوي"
  },
  "اطبع": {
    "prefix": "اطبع",
    "body": [
      "اطبع(ن\"${1:مرحباً بك في لسان}\")"
    ],
    "description": "طباعة نص منسّق إلى المخرجات"
  },
  "مع": {
    "prefix": "مع",
    "body": [
      "مع افتح(\"${1:بيانات.txt}\"، \"${2|ق,ك,ح|}\") كـ ${3:ملف} {",
      "    ${4:دع محتوى = ملف.اقرأ()}",
      "    ${5:اطبع(محتوى)}",
      "}"
    ],
    "description": "مدير السياق لفتح وقراءة أو كتابة الملفات بأمان"
  },
  "قاعدة_بيانات": {
    "prefix": "قاعدة_بيانات",
    "body": [
      "استورد \"قاعدة_بيانات\"",
      "",
      "دع قاعدة = جديد قاعدة_بيانات(\"${1:بياناتي.json}\")",
      "قاعدة.أنشئ_جدول(\"${2:المستخدمون}\")",
      "قاعدة.أدرج(\"${2:المستخدمون}\"، {\"الاسم\": \"${3:سارة}\"، \"الدور\": \"مطورة\"})",
      "اطبع(قاعدة.استعلم(\"${2:المستخدمون}\"))"
    ],
    "description": "استخدام قاعدة البيانات المدمجة لإنشاء الجداول والاستعلام"
  }
}
