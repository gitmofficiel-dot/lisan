{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lisan",
  "scopeName": "source.lisan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#fstrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lisan",
          "match": "(#|//).*$"
        }
      ]
    },
    "fstrings": {
      "name": "string.interpolated.lisan",
      "begin": "ن\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.lisan"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.lisan"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.lisan",
          "match": "(\\{\\{|\\}\\}|\\\\.)"
        },
        {
          "name": "meta.embedded.expression.lisan",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.lisan"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.lisan"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lisan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lisan",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.arabic.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])[٠-٩۰-۹0-9]+([.٫][٠-٩۰-۹0-9]+)?([eE][+-]?[٠-٩۰-۹0-9]+)?(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(دالة)(?![\\p{L}\\p{M}\\p{N}_ـ])\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_ـ]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.lisan"
            },
            "2": {
              "name": "entity.name.function.lisan"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(صنف|فئة|هيكل)(?![\\p{L}\\p{M}\\p{N}_ـ])\\s+([\\p{L}_][\\p{L}\\p{M}\\p{N}_ـ]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.lisan"
            },
            "2": {
              "name": "entity.name.type.class.lisan"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.lisan",
          "match": "(?<=:\\s*|->\\s*)(?<![\\p{L}\\p{M}\\p{N}_ـ])(عدد|نص|منطقي|قائمة|قاموس|صف|مجموعة|فارغ|أي|دالة)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "support.type.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(منطقي|قائمة|قاموس|صف|مجموعة|فارغ)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(إذا|اذا|وإلا|والا|طالما|بينما|لكل|في|أرجع|ارجع|توقف|تابع|حاول|التقط|أمسك|امسك|أخيرًا|أخيرا|اخيرا|ارمِ|ارم|ألقِ|الق|اختر|حالة|افتراضي|مع)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "keyword.declaration.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(دع|ليكن|متغير|ثابت|دالة|صنف|فئة|هيكل|يرث|يمتد|جديد|استورد|من|كـ|ك|باسم|كاسم)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "keyword.operator.logical.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(و|أو|او|ليس)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(صحيح|خطأ|خطا|لاشيء|ط|قيمة_ط|هـ|قيمة_هـ)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "variable.language.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(هذا)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(اطبع|طول|نوع|نص|عدد|عدد_صحيح|أضف|ألحق|مدى|يحتوي|مفاتيح|قيم|احذف|قسّم|ادمج|استبدل|اقتطع|نظّف|مطلق|جذر|قرّب|أرضية|سقف|قوة|أدنى|أعلى|جا|جتا|ظا|لوغاريتم|لوغ|أسي|اسي|مضروب|عامل|توافيق|تباديل|قاسم_مشترك|مضاعف_مشترك|تقارب|وسيط|منوال|تباين|انحراف_معياري|ارتباط|اقرأ_ملف|اكتب_ملف|ألحق_ملف|ملف_موجود|مجلد_موجود|أنشئ_مجلد|قائمة_ملفات|احذف_ملف|مسار_حالي|افتح|اطلب_ويب|جلب_ويب|طلب_وب|تحقق|تحقق_يساوي|عكس|فرز|خلط|مجموع|متوسط|ابحث|يبدأ_ب|ينتهي_ب|كرر|أحرف_كبيرة|أحرف_صغيرة|ادخل|الآن|طابع_زمني|نظام_تشغيل|عشوائي|عدد_عشوائي|عنصر_عشوائي|بيئة|وسائط|تنسيق|سحاب|مرقم|أي|كل|ترميز_قاعدة64|فك_قاعدة64|ترميز_رابط|فك_رابط|تحليل_جيسون|ترميز_جيسون|تحليل_جداول|ترميز_جداول|تاريخ_اليوم|فرق_أيام|أضف_أيام|يوم_الأسبوع|تجزئة_أمان|توقيع_أمان|معرف_فريد|شفر_نص|فك_تشفير_نص|يطابق_نمط|استخرج_نمط|استبدل_نمط|معلومات_النظام|عرض_قالب|نفّذ_أمر|إعادة_تشغيل|اعادة_تشغيل)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "support.class.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(موقع_ويب|تطبيق_هاتف|تطبيق_ويب|قالب_صفحة|قاعدة_بيانات|تشفير_أمان|محلل_أنماط|مصفوفة|جدول_بيانات|انحدار_خطي|شبكة_عصبية|محلل_نص_عربي|مخطط_أعمدة|مخطط_خطي|مخطط_دائري|لعبة_ثنائية_الأبعاد|أداة_سطر_أوامر|سجل_أحداث|مجدول_مهام|متحكم_تناسبي_تكاملي|مرشح_كالمان|روبوت_متحرك|ذراع_آلي|آلة_حالات|مودباس_صناعي|لوحة_راسبيري|لوحة_بيكو|منفذ_بيكو|نبضة_بيكو|محول_تماثلي_بيكو|مؤقت_بيكو|مستشعر_حرارة_داخلي_بيكو|كاميرا_راسبيري|صوت_راسبيري|محرك_سيرفو|محرك_خطوي|حساس_مسافة|حساس_حرارة|شاشة_كريستال|شريط_إضاءة|زر_ضاغط|جرس_تنبيه|مرحل_كهربائي|حساس_رطوبة_تربة|حساس_مطر|حساس_لهب|حساس_تسارع_جيروسكوب|حساس_ضغط_جوي|شاشة_سبع_قطع|حساس_صوت|حساس_مستوى_ماء)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lisan",
          "match": "(=>|->|\\*\\*|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=<>!])"
        }
      ]
    }
  }
}
