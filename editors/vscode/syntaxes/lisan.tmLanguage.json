{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lisan",
  "scopeName": "source.lisan",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lisan",
          "match": "(#|//).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lisan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lisan",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lisan",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(دع|ليكن|متغير|اطبع|إذا|اذا|وإلا|والا|طالما|بينما|لكل|في|دالة|استورد|أرجع|ارجع|توقف|تابع|و|أو|او|ليس|حاول|التقط|أمسك|امسك|أخيرًا|أخيرا|اخيرا|ارمِ|ارم|ألقِ|الق|اختر|حالة|افتراضي|صنف|فئة|هيكل|يرث|يمتد|جديد|مع|كـ|باسم|كاسم|من)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(صحيح|خطأ|خطا|لاشيء)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        },
        {
          "name": "variable.language.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(هذا)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lisan",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_ـ])(اطبع|طول|نوع|نص|عدد|أضف|مدى|يحتوي|مفاتيح|قيم|احذف|قسّم|ادمج|استبدل|اقتطع|نظّف|مطلق|جذر|قرّب|أرضية|سقف|قوة|أدنى|أعلى|اقرأ_ملف|اكتب_ملف|ألحق_ملف|ملف_موجود|مجلد_موجود|أنشئ_مجلد|قائمة_ملفات|احذف_ملف|مسار_حالي|اطلب_ويب|جلب_ويب|تحقق|تحقق_يساوي|عكس|فرز|مجموع|متوسط|ابحث|يبدأ_ب|ينتهي_ب|كرر|أحرف_كبيرة|أحرف_صغيرة|ادخل|الآن|عدد_صحيح|عشوائي|عدد_عشوائي|عنصر_عشوائي|بيئة|وسائط|تحليل_json|ترميز_json|تنسيق)(?![\\p{L}\\p{M}\\p{N}_ـ])"
        }
      ]
    }
  }
}