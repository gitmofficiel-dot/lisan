{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lisan",
  "scopeName": "source.lisan",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lisan",
          "match": "(#|//).*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lisan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lisan",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lisan",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lisan",
          "match": "\\b(دع|ثابت|متغير|دالة|صنف|فئة|هيكل|يرث|يمتد|جديد|هذا|ذاتي|أصل|إذا|اذا|وإلا|والا|طالما|لكل|في|أرجع|ارجع|أوقف|اوقف|تخطى|استمر|حاول|امسك|افرض|استورد|و|أو|او|ليس)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lisan",
          "match": "\\b(صحيح|خطأ|خطا|لاشيء|عدم|فارغ)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lisan",
          "match": "\\b(اطبع|طول|نوع|نص|عدد|أضف|مدى|يحتوي|مفاتيح|قيم|احذف|قسّم|ادمج|استبدل|اقتطع|نظّف|مطلق|جذر|قرّب|أرضية|سقف|قوة|أدنى|أعلى|اقرأ_ملف|اكتب_ملف|ألحق_ملف|ملف_موجود|مجلد_موجود|أنشئ_مجلد|قائمة_ملفات|احذف_ملف|مسار_حالي|اطلب_ويب|جلب_ويب|تحقق|تحقق_يساوي|عكس|فرز|مجموع|متوسط|ابحث|يبدأ_ب|ينتهي_ب|كرر|أحرف_كبيرة|أحرف_صغيرة|ادخل|الآن|عدد_صحيح|عشوائي|عدد_عشوائي|عنصر_عشوائي|بيئة|وسائط|تحليل_json|ترميز_json|تنسيق)\\b"
        }
      ]
    }
  }
}
