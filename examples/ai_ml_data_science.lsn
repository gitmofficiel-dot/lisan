# ============================================================================
# مثال شامل لعلوم البيانات والذكاء الاصطناعي وتعلّم الآلة ومعالجة اللغة العربية
# لغة البرمجة العربية لسان — تشغيل: lisan examples/ai_ml_data_science.lsn
# ============================================================================

استورد "ذكاء"

اطبع("==============================================================")
اطبع("  مختبر الذكاء الاصطناعي وعلوم البيانات بلغة لسان العربية")
اطبع("==============================================================")

# ----------------------------------------------------------------------------
# 1. الجبر الخطي والمصفوفات (صنف مصفوفة)
# ----------------------------------------------------------------------------
اطبع("\n--- 1. الجبر الخطي والمصفوفات ---")
دع أ = جديد مصفوفة([[1، 2، 3]، [4، 5، 6]])
دع ب = جديد مصفوفة([[7، 8]، [9، 10]، [11، 12]])
دع حاصل_الضرب = أ.ضرب(ب)
دع منقولة_أ = أ.منقول()
اطبع("أبعاد المصفوفة أ: " + نص(أ.أبعاد()))
اطبع("أبعاد حاصل الضرب (أ × ب): " + نص(حاصل_الضرب.أبعاد()))
اطبع("حاصل الضرب [0،0] = " + نص(حاصل_الضرب.قيمة(0، 0)) + " | [1،1] = " + نص(حاصل_الضرب.قيمة(1، 1)))
اطبع("أبعاد منقول أ: " + نص(منقولة_أ.أبعاد()))

دع أوزان = جديد مصفوفة([[-1.5، 0.0، 2.5]، [1.0، -0.5، 3.0]])
دع بعد_ريلو = أوزان.تفعيل_ريلو()
دع بعد_سيجمويد = أوزان.تفعيل_سيجمويد()
اطبع("مجموع القيم بعد ReLU: " + نص(بعد_ريلو.مجموع_الكل()))
اطبع("سيجمويد(0.0) = " + نص(بعد_سيجمويد.قيمة(0، 1)))

# ----------------------------------------------------------------------------
# 2. إطار البيانات (صنف جدول_بيانات — Pandas للغة لسان)
# ----------------------------------------------------------------------------
اطبع("\n--- 2. تحليل البيانات بجدول_بيانات ---")
دع مبيعات = جديد جدول_بيانات([
    {"المدينة": "الرياض"، "القطاع": "ذكاء_اصطناعي"، "الإيراد": 45000}،
    {"المدينة": "جدة"، "القطاع": "تعليم_تقني"، "الإيراد": 28000}،
    {"المدينة": "الرياض"، "القطاع": "سحابة"، "الإيراد": 52000}،
    {"المدينة": "القاهرة"، "القطاع": "ذكاء_اصطناعي"، "الإيراد": 39000}،
    {"المدينة": "دبي"، "القطاع": "سحابة"، "الإيراد": 61000}
])
مبيعات.أضف_صف({"المدينة": "الدمام"، "القطاع": "تعليم_تقني"، "الإيراد": 25000})

اطبع("عدد السجلات: " + نص(مبيعات.عدد_الصفوف()))
اطبع("الأعمدة: " + نص(مبيعات.الأعمدة()))
دع ملخص_الإيراد = مبيعات.ملخص("الإيراد")
اطبع("ملخص الإيرادات: " + نص(ملخص_الإيراد))

دع صفقات_الرياض = مبيعات.تصفية("المدينة"، "الرياض")
اطبع("مجموع إيرادات الرياض: " + نص(صفقات_الرياض.مجموع_عمود("الإيراد")))
اطبع("توزيع الصفقات حسب القطاع: " + نص(مبيعات.تجميع_عدد("القطاع")))

دع نص_csv = مبيعات.إلى_csv()
دع جدول_مستعاد = جديد جدول_بيانات()
جدول_مستعاد.من_csv(نص_csv)
اطبع("التحقق من استعادة CSV — عدد الصفوف: " + نص(جدول_مستعاد.عدد_الصفوف()) + " | المجموع: " + نص(جدول_مستعاد.مجموع_عمود("الإيراد")))

# ----------------------------------------------------------------------------
# 3. الانحدار الخطي (صنف انحدار_خطي)
# ----------------------------------------------------------------------------
اطبع("\n--- 3. التنبؤ بالانحدار الخطي ---")
دع نموذج_أسعار = جديد انحدار_خطي()
دع المساحات = [80، 100، 120، 150، 200، 250]
دع الأسعار = [290، 350، 410، 500، 650، 800]
نموذج_أسعار.درّب(المساحات، الأسعار)

اطبع("الميل (سعر المتر): " + نص(نموذج_أسعار.الميل()))
اطبع("التقاطع (القيمة الأساسية): " + نص(نموذج_أسعار.التقاطع()))
اطبع("دقة النموذج (R^2): " + نص(نموذج_أسعار.دقة_r2(المساحات، الأسعار)))
اطبع("السعر المتوقع لمساحة 180 متر²: " + نص(نموذج_أسعار.توقّع(180)) + " ألف")

# ----------------------------------------------------------------------------
# 4. مصنف أقرب الجيران (صنف مصنف_جيران_knn)
# ----------------------------------------------------------------------------
اطبع("\n--- 4. التصنيف بخوارزمية أقرب الجيران (KNN) ---")
دع مصنف_عملاء = جديد مصنف_جيران_knn(3)
دع ميزات_العملاء = [
    [15، 2]، [20، 3]، [18، 1]،
    [85، 14]، [92، 18]، [88، 16]
]
دع فئات_العملاء = ["عادي"، "عادي"، "عادي"، "مميز"، "مميز"، "مميز"]
مصنف_عملاء.درّب(ميزات_العملاء، فئات_العملاء)

اطبع("تصنيف عميل [17، 2]: " + مصنف_عملاء.توقّع([17، 2]))
اطبع("تصنيف عميل [90، 15]: " + مصنف_عملاء.توقّع([90، 15]))

# ----------------------------------------------------------------------------
# 5. الشبكة العصبية متعددة الطبقات (صنف شبكة_عصبية — Backpropagation)
# ----------------------------------------------------------------------------
اطبع("\n--- 5. تدريب شبكة عصبية حقيقية بالانتشار العكسي ---")
دع شبكة_أو = جديد شبكة_عصبية(2، 3، 1.5)
دع مدخلات_منطقية = [[0، 0]، [0، 1]، [1، 0]، [1، 1]]
دع أهداف_أو = [0، 1، 1، 1]

دع خسارة_نهائية = شبكة_أو.درّب(مدخلات_منطقية، أهداف_أو، 120)
اطبع("متوسط الخسارة النهائية لبوابة OR: " + نص(قرّب(خسارة_نهائية * 10000) / 10000))
لكل نقطة في مدخلات_منطقية {
    دع احتمال = قرّب(شبكة_أو.توقّع(نقطة) * 1000) / 1000
    اطبع("  توقع " + نص(نقطة) + " => " + نص(احتمال))
}

# ----------------------------------------------------------------------------
# 6. معالجة اللغة العربية الطبيعية (صنف محلل_نص_عربي)
# ----------------------------------------------------------------------------
اطبع("\n--- 6. معالجة اللغة العربية الطبيعية وتحليل المشاعر ---")
دع محلل = جديد محلل_نص_عربي()
دع نص_مشكول = "لُغَةُ لِسَانٍ الْعَرَبِيَّةُ مُمْتَازَةٌ وَرَائِعَةٌ وَسَرِيعَةٌ جِدًّا!"
اطبع("بعد إزالة التشكيل: " + محلل.أزل_التشكيل(نص_مشكول))
اطبع("بعد توحيد الحروف: " + محلل.وحّد_الحروف("أحمد وإيمان وآمنة في مدرسة كبرى"))

دع مراجعات = [
    "تجربة ممتازة ورائعة، التطبيق سريع وسهل ومفيد جداً!"،
    "للأسف النظام سيء وبطيء ومزعج وفيه أعطال ومشاكل."،
    "وصل الطلب إلى مكتب الاستلام في الساعة التاسعة صباحاً."
]
لكل مراجعة في مراجعات {
    دع نتيجة_شعور = محلل.تحليل_المشاعر(مراجعة)
    اطبع("المراجعة: «" + مراجعة + "»")
    اطبع("  => التصنيف: " + نتيجة_شعور["التصنيف"] + " | الدرجة: " + نص(نتيجة_شعور["الدرجة"]))
}

اطبع("\n✅ اكتملت جميع تجارب الذكاء الاصطناعي وعلوم البيانات بنجاح!")
