# حساب مجموع قائمة باستخدام دالة وحلقة لكل
دالة احسب_المجموع(قياسات) {
    دع المجموع = 0؛
    لكل (قيمة في قياسات) {
        المجموع = المجموع + قيمة؛
    }
    أرجع المجموع؛
}

دع درجات = [16، 18، 19]؛
درجات = أضف(درجات، 20)؛
اطبع("عدد الدرجات: " + طول(درجات))؛
اطبع("المجموع: " + احسب_المجموع(درجات))؛
اطبع("هل توجد الدرجة 20؟ " + يحتوي(درجات، 20))؛
