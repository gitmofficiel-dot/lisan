# تحكم في مصباح وحساس مسافة وشاشة على أردوينو
استورد "اردوينو"

دع منفذ_مصباح = 13

دالة إعداد() {
    تسلسلي_ابدأ(9600)
    وضع_المنفذ(منفذ_مصباح، "مخرج")
    تسلسلي_اطبع("النظام جاهز")
}

دالة تكرار() {
    دع ضوء = اقرأ_تماثلي(0)
    إذا (ضوء > 500) {
        اكتب_رقمي(منفذ_مصباح، 1)
    } وإلا {
        اكتب_رقمي(منفذ_مصباح، 0)
    }
    انتظر_ملي(500)
}

دع حساس = جديد حساس_مسافة(5، 6)
حساس.ضبط_محاكاة(15)
اطبع("هل يوجد جسم قريب؟ " + نص(حساس.هل_قريب(20)))

دع شاشة = جديد شاشة_كريستال(16، 2)
شاشة.اطبع_في(0، 0، "مرحبا من لسان")
اطبع("السطر الأول: " + شاشة.محتوى_السطر(0))
