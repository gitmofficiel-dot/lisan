# مثال شامل لبرمجة الأردوينو والمتحكمات الدقيقة بلغة لسان
استورد "اردوينو"

دع منفذ_مصباح = 13
دع منفذ_مروحة = 9

دالة إعداد() {
    تسلسلي_ابدأ(9600)
    وضع_المنفذ(منفذ_مصباح، "مخرج")
    وضع_المنفذ(منفذ_مروحة، "مخرج")
    تسلسلي_اطبع("نظام المنزل الذكي جاهز")
}

دالة تكرار() {
    دع ضوء = اقرأ_تماثلي(0)
    إذا (ضوء > 500) {
        اكتب_رقمي(منفذ_مصباح، 1)
        اكتب_تماثلي(منفذ_مروحة، 180)
    } وإلا {
        اكتب_رقمي(منفذ_مصباح، 0)
        اكتب_تماثلي(منفذ_مروحة، 0)
    }
    انتظر_ملي(500)
}

دع سيرفو_الباب = جديد محرك_سيرفو(10)
اطبع("زاوية السيرفو: " + نص(سيرفو_الباب.حرك(90)))

دع حساس_المسافة = جديد حساس_مسافة(5، 6)
حساس_المسافة.ضبط_محاكاة(15)
اطبع("هل يوجد جسم قريب؟ " + نص(حساس_المسافة.هل_قريب(20)))

دع شاشة = جديد شاشة_كريستال(16، 2)
شاشة.اطبع_في(0، 0، "مرحبا من لسان")
اطبع("السطر الأول في الشاشة: " + شاشة.محتوى_السطر(0))

دع شبكة = جديد واي_فاي_متحكم()
شبكة.اتصل("Lisan_Home_5G"، "12345678")
اطبع("عنوان IP للمتحكم: " + شبكة.عنوان_ip())
