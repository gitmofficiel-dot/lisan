# ============================================================================
# مثال شامل للتزامن والتوازي والربط الأصلي مع مكتبات C (C ABI FFI) في لغة لسان
# التشغيل: lisan examples/async_and_ffi.lsn
# ============================================================================

استورد "تزامن"
استورد "ربط_خارجي"

اطبع("================================================================")
اطبع("  مختبر التزامن الحقيقي والربط الأصلي (C ABI FFI) بلغة لسان")
اطبع("================================================================")

# ----------------------------------------------------------------------------
# 1. المهام والوعود وسلاسل المتابعة (صنف مهمة و صنف وعد)
# ----------------------------------------------------------------------------
اطبع("\n--- 1. المهام والوعود وسلاسل المتابعة ---")

دع مهمة_حساب = جديد مهمة(دالة() {
    أرجع 21
})
دع مهمة_مضاعفة = مهمة_حساب.ثم(دالة(قيمة) => قيمة * 2)
اطبع(ن"نتيجة السلسلة: {مهمة_مضاعفة.انتظر()} | منجزة؟ {مهمة_حساب.منجزة()}")

دع وعد_معطل = جديد وعد(دالة() {
    ارمِ "تعذّر الوصول للخادم مؤقتًا"
})
دع وعد_بديل = وعد_معطل.عند_الخطأ(دالة(سبب) => ن"قيمة احتياطية بعد: {سبب}")
اطبع(وعد_بديل.انتظر())

# ----------------------------------------------------------------------------
# 2. القنوات (صنف قناة — طابور رسائل FIFO)
# ----------------------------------------------------------------------------
اطبع("\n--- 2. قناة تمرير الرسائل (FIFO) ---")

دع قناة_مهام = جديد قناة()
قناة_مهام.أرسل("رسالة أولى").أرسل("رسالة ثانية").أرسل("رسالة ثالثة")
اطبع(ن"عدد الرسائل في القناة: {قناة_مهام.حجم()} | أول رسالة (معاينة): {قناة_مهام.معاينة()}")

طالما (ليس قناة_مهام.فارغة()) {
    دع رسالة = قناة_مهام.استقبل()
    اطبع(ن"  استلمت: {رسالة}")
}
اطبع(ن"هل القناة فارغة الآن؟ {قناة_مهام.فارغة()}")

# ----------------------------------------------------------------------------
# 3. حلقة الأحداث وجدولة المهام (صنف حلقة_أحداث و انتظر_الكل)
# ----------------------------------------------------------------------------
اطبع("\n--- 3. حلقة الأحداث وانتظار المهام ---")

دع حلقة = جديد حلقة_أحداث()
حلقة.أضف_مهمة(جديد مهمة(دالة() => 10 + 5))
حلقة.أضف_مهمة(دالة() => 20 * 2)
حلقة.أضف_مهمة(مهمة_منجزة(100))
اطبع(ن"عدد المهام المجدولة: {حلقة.عدد_المهام()}")

دع نتائج_الحلقة = حلقة.شغّل_الكل()
اطبع(ن"نتائج حلقة الأحداث: {نتائج_الحلقة}")

دع جميع_النتائج = انتظر_الكل([
    جديد مهمة(دالة() => "معالجة البيانات")،
    مهمة_منجزة("تحديث الفهرس")،
    جديد وعد(دالة() => "تصدير التقرير")
])
اطبع(ن"نتائج انتظر_الكل: {جميع_النتائج}")

دع أسرع_نتيجة = حلقة.انتظر_أول([
    مهمة_مرفوضة("محاولة أولى فشلت")،
    جديد مهمة(دالة() => "نجاح من المصدر الاحتياطي")
])
اطبع(ن"نتيجة انتظر_أول: {أسرع_نتيجة}")

# ----------------------------------------------------------------------------
# 4. التنفيذ المتوازي الحقيقي عبر خيوط نظام التشغيل (تشغيل_متوازٍ)
# ----------------------------------------------------------------------------
اطبع("\n--- 4. التنفيذ المتوازي الحقيقي (تشغيل_متوازٍ) ---")

دع مهام_متوازية = [
    "دع مجموع = 0\nلكل رقم في مدى(1، 101) { مجموع = مجموع + رقم }\nاطبع(مجموع)"،
    "دع عاملي = 1\nلكل ع في مدى(1، 7) { عاملي = عاملي * ع }\nاطبع(عاملي)"،
    "اطبع(\"رسالة من خيط ثالث مستقل\")"
]

دع نتائج_التوازي = تشغيل_متوازٍ(مهام_متوازية)
دع فهرس = 1
لكل سجل في نتائج_التوازي {
    دع نجاح_خيط = سجل["نجاح"]
    دع مخرجات_خيط = سجل["مخرجات"]
    اطبع(ن"  خيط {فهرس}: نجاح={نجاح_خيط} | مخرجات={مخرجات_خيط}")
    فهرس = فهرس + 1
}

# ----------------------------------------------------------------------------
# 5. الربط الأصلي مع مكتبات C عبر C ABI FFI (صنف مكتبة_خارجية)
# ----------------------------------------------------------------------------
اطبع("\n--- 5. الاستدعاء الأصلي لدوال C عبر مكتبة_خارجية ---")

دع رياضيات_أصلية = جديد مكتبة_خارجية("مكتبة_الرياضيات")
إذا (رياضيات_أصلية.متوفرة()) {
    دع جتا_صفر = رياضيات_أصلية.استدعِ("cos"، "عشري->عشري"، [0.0])
    دع أس_عشرة = رياضيات_أصلية.استدعِ("pow"، "عشري،عشري->عشري"، [2.0، 10.0])
    دع جذر_واحد_وثمانين = رياضيات_أصلية.استدعِ("sqrt"، "عشري->عشري"، [81.0])
    اطبع(ن"  C cos(0.0)     = {جتا_صفر}")
    اطبع(ن"  C pow(2, 10)   = {أس_عشرة}")
    اطبع(ن"  C sqrt(81.0)   = {جذر_واحد_وثمانين}")
} وإلا {
    اطبع("  مكتبة الرياضيات الأصلية غير متوفرة في هذه البيئة")
}

دع نظام_أصلي = جديد مكتبة_خارجية("مكتبة_النظام")
إذا (نظام_أصلي.متوفرة()) {
    دع طول_بايتات = نظام_أصلي.استدعِ("strlen"، "نص->صحيح"، ["مرحبا"])
    اطبع(ن"  C strlen(\"مرحبا\") = {طول_بايتات} بايت (UTF-8)")
}

اطبع("\nاكتمل تشغيل مثال التزامن والربط الأصلي بنجاح!")
