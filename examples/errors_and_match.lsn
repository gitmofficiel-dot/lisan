// مثال يوضح معالجة الأخطاء (حاول / التقط / أخيرًا) وجملة الاختيار (اختر / حالة / افتراضي) في لسان

دالة قسمة_آمنة(أ، ب) {
    حاول {
        إذا (ب == 0) {
            ارمِ "لا يمكن القسمة على الصفر!"؛
        }
        أرجع أ / ب؛
    } التقط (استثناء) {
        اطبع("تحذير: " + استثناء)؛
        أرجع 0؛
    } أخيرًا {
        اطبع("انتهت محاولة عملية القسمة.")؛
    }
}

دالة تقييم_النتيجة(درجة) {
    اختر (درجة) {
        حالة "ممتاز": {
            أرجع "تهانينا! أداء رائع"؛
        }
        حالة "جيد": {
            أرجع "عمل جيد، واصل التقدم"؛
        }
        حالة "مقبول": {
            أرجع "يحتاج إلى بعض الجهد الإضافي"؛
        }
        افتراضي: {
            أرجع "حالة غير محددة"؛
        }
    }
}

اطبع("=== تجربة معالجة الاستثناءات ===")؛
ليكن ن1 = قسمة_آمنة(100، 5)؛
اطبع("ناتج 100 / 5 = " + ن1)؛

ليكن ن2 = قسمة_آمنة(50، 0)؛
اطبع("ناتج 50 / 0 = " + ن2)؛

اطبع("\n=== تجربة جمل الاختيار (اختر / حالة) ===")؛
اطبع("ممتاز: " + تقييم_النتيجة("ممتاز"))؛
اطبع("جيد: " + تقييم_النتيجة("جيد"))؛
اطبع("ضعيف: " + تقييم_النتيجة("ضعيف"))؛
