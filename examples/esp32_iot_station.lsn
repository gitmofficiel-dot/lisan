# محطة إنترنت الأشياء الذكية بمتحكم ESP32 بلغة لسان
استورد "esp32"

دع منفذ_المصباح = 2
دع منفذ_الحساس = 34
دع منفذ_اللمس = 4
دع منفذ_dac = 25

دالة إعداد() {
    تسلسلي_ابدأ(115200)
    تسلسلي_اطبع("=== بدء تشغيل محطة إنترنت الأشياء ESP32 بلغة لسان ===")
    وضع_المنفذ(منفذ_المصباح، "OUTPUT")
}

دالة تكرار() {
    انتظر_ملي(1000)
}

# 1. الاتصال بالشبكة اللاسلكية WiFi
دع شبكة = جديد واي_فاي_esp()
شبكة.اتصل("منزل_لسان_الذكي"، "كلمة_المرور_123")
اطبع("حالة الاتصال بالواي فاي: " + نص(شبكة.هل_متصل()))
اطبع("عنوان IP للجهاز: " + شبكة.عنوان_ip())
اطبع("قوة إشارة WiFi: " + نص(شبكة.قوة_الاشارة()) + " dBm")

# 2. تشغيل خادم ويب مدمج للتحكم عبر المتصفح
دع خادم = جديد خادم_ويب_esp(80)
خادم.عند_طلب("/", "<h1>أهلاً بك في متحكم ESP32 بلغة لسان</h1><p>النظام يعمل بنجاح</p>")
خادم.عند_طلب("/api/status", "{\"status\": \"active\", \"lang\": \"lisan\"}")
خادم.ابدأ()
اطبع("خادم الويب يعمل وجاهز لاستقبال الطلبات.")

# 3. الربط مع وسيط MQTT لإنترنت الأشياء
دع عميل = جديد عميل_mqtt("broker.hivemq.com"، 1883)
عميل.اتصل("Lisan_ESP32_Device_01")
عميل.انشر("lisan/iot/temperature", "24.8")
عميل.اشترك("lisan/iot/commands")
اطبع("تم تفعيل بروتوكول MQTT بنجاح.")

# 4. حساس اللمس والمحول الرقمي عالي الدقة 12-bit ADC
دع لمس = جديد حساس_لمس_esp(منفذ_اللمس)
اطبع("قيمة حساس اللمس: " + نص(لمس.اقرأ_قيمة()))
اطبع("هل تم لمس الحساس؟ " + نص(لمس.هل_ملموس()))

دع محول = جديد محول_تماثلي_esp(منفذ_الحساس)
اطبع("قراءة ADC بدقة 12 بت: " + نص(محول.اقرأ_رقمي_12bit()))
اطبع("الجهد المحسوب: " + نص(محول.اقرأ_جهد_ملي_فولت()) + " ملي فولت")

# 5. محول DAC الحقيقي لإخراج جهد مستمر
دع مخرج_تناظري = جديد محول_رقمي_esp(منفذ_dac)
اطبع("تم ضبط جهد DAC التناظري إلى: " + نص(مخرج_تناظري.اكتب_جهد(2.5)) + " فولت")

# 6. إدارة توفير الطاقة والنوم العميق
دع إدارة_الطاقة = جديد نوم_عميق_esp()
اطبع("إدارة الطاقة جاهزة للدخول في وضع Deep Sleep.")
