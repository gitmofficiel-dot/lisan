# مثال يوضح الدوال والميزات الجديدة في لغة لسان
# تشغيل: ./target/release/lisan examples/extended_features.lsn

اطبع("=== تجربة دوال القوائم والمصفوفات ===")؛
دع درجات = [14, 18, 12, 20, 16]؛
اطبع("الدرجات: " + نص(درجات))؛
اطبع("الدرجات بعد الفرز: " + نص(فرز(درجات)))؛
اطبع("الدرجات بالعكس: " + نص(عكس(درجات)))؛
اطبع("مجموع الدرجات: " + نص(مجموع(درجات)))؛
اطبع("المعدل (المتوسط): " + نص(متوسط(درجات)))؛
اطبع("موقع العلامة الكاملة (20): " + نص(ابحث(درجات، 20)))؛

اطبع("")؛
اطبع("=== تجربة دوال النصوص المتقدمة ===")؛
دع جملة = "لغة لسان العربية الفصيحة"؛
اطبع("الجملة: " + جملة)؛
اطبع("هل تبدأ بـ 'لغة'؟ " + نص(يبدأ_ب(جملة، "لغة")))؛
اطبع("هل تنتهي بـ 'الفصيحة'؟ " + نص(ينتهي_ب(جملة، "الفصيحة")))؛
اطبع("عكس الجملة: " + عكس("لسان"))؛
اطبع("تكرار: " + كرر("مرحبا! "، 3))؛
اطبع("تحويل لكبير: " + أحرف_كبيرة("lisan language"))؛
اطبع("تحويل لصغير: " + أحرف_صغيرة("LISAN 2026"))؛

اطبع("")؛
اطبع("=== تجربة الدوال الرياضية الجديدة ===")؛
اطبع("أرضية 7.89 = " + نص(أرضية(7.89)))؛
اطبع("سقف 7.12 = " + نص(سقف(7.12)))؛
اطبع("2 أس 8 بواسطة قوة = " + نص(قوة(2، 8)))؛
اطبع("2 أس 8 بواسطة العامل ** = " + نص(2 ** 8))؛
