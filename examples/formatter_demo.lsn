# مثال لتوضيح قدرات منسق لسان الآلي
# نفّذ: lisan نسّق examples/formatter_demo.lsn

دالة احسب_الضرائب(المبلغ، النسبة) {
    دع الإجمالي = المبلغ + (المبلغ * (النسبة / 100))
    إذا (الإجمالي > 1000) {
        اطبع("مبلغ كبير")
    } إلا {
        اطبع("مبلغ عادي")
    }
    أرجع الإجمالي
}

دع س = [1، 2، 3]
دع قاموس = {"اسم":"أحمد"، "عمر":25}
    اطبع(احسب_الضرائب(500، 15))
