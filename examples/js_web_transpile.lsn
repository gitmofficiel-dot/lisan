# مثال برمجي عربي خالص يعمل في لسان ويُترجم بنظافة إلى Python 3 و ES2022 JavaScript
# تشغيل مباشر بلسان:  lisan examples/js_web_transpile.lsn
# ترجمة إلى بايثون:   lisan --python examples/js_web_transpile.lsn
# ترجمة إلى جافاسكربت: lisan --js examples/js_web_transpile.lsn

صنف عنصر_متجر {
    دالة بناء(اسم، سعر، كمية = 1) {
        هذا.اسم = اسم
        هذا.سعر = سعر
        هذا.كمية = كمية
    }

    دالة إجمالي() {
        أرجع هذا.سعر * هذا.كمية
    }

    دالة ملخص() {
        أرجع ن"{هذا.اسم} × {هذا.كمية} = {هذا.إجمالي()}"
    }
}

صنف عنصر_مخفض يرث عنصر_متجر {
    دالة بناء(اسم، سعر، كمية = 1، خصم_نسبة = 10) {
        هذا.اسم = اسم
        هذا.سعر = سعر
        هذا.كمية = كمية
        هذا.خصم_نسبة = خصم_نسبة
    }

    دالة إجمالي_بعد_الخصم() {
        دع قبل = هذا.إجمالي()
        أرجع قبل - (قبل * هذا.خصم_نسبة / 100)
    }
}

دالة اجمع_القيم(بداية، *قيم) {
    دع كلي = بداية
    لكل ق في قيم {
        كلي = كلي + ق
    }
    أرجع كلي
}

دالة تصنيف_فاتورة(قيمة) {
    دع رتبة = "عادية"
    إذا (قيمة >= 500) {
        رتبة = "مميزة"
    } وإلا {
        إذا (قيمة >= 200) {
            رتبة = "متوسطة"
        }
    }
    أرجع رتبة
}

دع كتاب = جديد عنصر_متجر("كتاب الخوارزميات العربية"، 120، 2)
دع لوحة = جديد عنصر_مخفض("لوحة مفاتيح عربية"، 300، 1، 20)

اطبع(كتاب.ملخص())
اطبع(ن"{لوحة.اسم} بعد الخصم = {لوحة.إجمالي_بعد_الخصم()}")

# توليد القوائم المختصر والدوال المجهولة والتقطيع
دع أرقام = [1، 2، 3، 4، 5، 6]
دع مربعات_زوجية = [س * س لكل س في أرقام إذا س % 2 == 0]
دع ضعّف = دالة(ع) => ع * 2
دع شريحة = أرقام[1:4]

اطبع(ن"عدد المربعات الزوجية: {طول(مربعات_زوجية)}")
اطبع(ن"مجموع الشريحة: {مجموع(شريحة)}")
اطبع(ن"تطبيق الدالة المجهولة: {ضعّف(15)}")
اطبع(ن"مجموع الوسائط المتغيرة: {اجمع_القيم(10، 20، 30، 40)}")

# الاختيار متعدد الحالات ومعالجة الأخطاء
دع إجمالي_السلة = كتاب.إجمالي() + لوحة.إجمالي_بعد_الخصم()
دع فئة_الطلب = تصنيف_فاتورة(إجمالي_السلة)

دع رسالة_الفئة = ""
اختر (فئة_الطلب) {
    حالة "مميزة":
        رسالة_الفئة = "شحن مجاني وهدية"
    حالة "متوسطة":
        رسالة_الفئة = "شحن قياسي سريع"
    افتراضي:
        رسالة_الفئة = "شحن عادي"
}

دع حالة_التحقق = "سليم"
حاول {
    إذا (إجمالي_السلة < 0) {
        ارمِ "قيمة سالبة غير منطقية"
    }
} التقط (خلل) {
    حالة_التحقق = "خطأ"
}

اطبع(ن"إجمالي السلة: {إجمالي_السلة} | الفئة: {فئة_الطلب} | {رسالة_الفئة} | التحقق: {حالة_التحقق}")
