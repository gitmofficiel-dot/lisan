// مثال يوضح التعامل مع JSON، وتوليد الأرقام العشوائية، ومتغيرات البيئة في لسان

اطبع("=== 1. التعامل مع JSON ===")؛
ليكن ملف_شخصي = {
    "الاسم": "عمر",
    "المهنة": "مهندس برمجيات",
    "المهارات": ["رست", "لسان", "بايثون"],
    "نشط": صحيح
}؛

ليكن نص_json = ترميز_json(ملف_شخصي)؛
اطبع("النص بعد الترميز: " + نص_json)؛

ليكن كائن_مسترجع = تحليل_json(نص_json)؛
اطبع("الاسم المسترجع: " + كائن_مسترجع["الاسم"])؛
اطبع("المهارة الأولى: " + كائن_مسترجع["المهارات"][0])؛

اطبع("\n=== 2. الأرقام والعشوائية ===")؛
اطبع("قيمة عشوائية بين 0 و 1: " + عشوائي())؛

ليكن رمية_نرد = عدد_عشوائي(1, 6)؛
اطبع("رمية نرد (1-6): " + رمية_نرد)؛

ليكن ألوان = ["أحمر", "أخضر", "أزرق", "ذهبي"]؛
ليكن لون_اليوم = عنصر_عشوائي(ألوان)؛
اطبع("لون اليوم العشوائي: " + لون_اليوم)؛

اطبع("\n=== 3. القوالب وتنسيق النصوص ===")؛
ليكن رسالة = تنسيق("مرحباً {}! دورك رقم {} واللون المخصص لك هو {}.", [كائن_مسترجع["الاسم"], رمية_نرد, لون_اليوم])؛
اطبع(رسالة)؛

اطبع("\n=== 4. البيئة والنظام ===")؛
اطبع("المسار الحالي: " + بيئة("PWD"))؛
