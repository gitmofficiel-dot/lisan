# ============================================================================
# استعراض شامل للمكتبة القياسية الموسّعة في لغة لسان 1.0.0
# التشفير (SHA-256 / HMAC / Stream Cipher / UUID)، التعابير النمطية (Regex)،
# معلومات النظام والوقت الدقيق، وقاعدة البيانات المستديمة (CRUD)
# ============================================================================

استورد "قاعدة_بيانات"

اطبع("==========================================================")
اطبع("   استعراض إمكانيات لغة لسان القياسية المتكاملة (1.0.0)   ")
اطبع("==========================================================")

دع وقت_البداية = وقت_دقيق_ملي()

# ----------------------------------------------------------------------------
# 1. التشفير والتجزئة والترميز الست عشري والمعرّفات الفريدة
# ----------------------------------------------------------------------------
اطبع("\n--- [1] التشفير والأمان السيبراني ---")

دع بصمة_قياسية = تجزئة_sha256("abc")
اطبع("تجزئة SHA-256 للنص 'abc': " + بصمة_قياسية)
تحقق_يساوي(بصمة_قياسية، "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

دع رسالة_مهمة = "تحويل مالي بقيمة 5000 دينار عبر نظام لسان الآمن"
دع مفتاح_سري = "مفتاح_المصادقة_الرئيسي_2026"
دع توقيع = توقيع_hmac(رسالة_مهمة، مفتاح_سري)
اطبع("توقيع HMAC-SHA256: " + توقيع)
تحقق_يساوي(طول(توقيع)، 64)

دع نص_سري = "سر المهنة: لغة لسان تجمع الفصاحة العربية وأداء Rust الصافي!"
دع نص_مشفر = شفر_نص(نص_سري، مفتاح_سري)
دع نص_مسترجع = فك_تشفير_نص(نص_مشفر، مفتاح_سري)
اطبع("النص المشفر (مقتطف): " + اقتطع(نص_مشفر، 0، 48) + "...")
اطبع("النص بعد فك التشفير: " + نص_مسترجع)
تحقق_يساوي(نص_مسترجع، نص_سري)

دع مرمز_ست_عشري = ترميز_ست_عشري("لسان")
تحقق_يساوي(فك_ست_عشري(مرمز_ست_عشري)، "لسان")

دع معرف_1 = معرف_فريد()
دع معرف_2 = معرف_فريد()
اطبع("معرّف الجلسة الفريد (UUID v4): " + معرف_1)
تحقق_يساوي(طول(معرف_1)، 36)
تحقق_صحيح(معرف_1 != معرف_2)

دع حارس = جديد تشفير_أمان(مفتاح_سري)
تحقق_صحيح(حارس.تحقق_توقيع(رسالة_مهمة، توقيع))

# ----------------------------------------------------------------------------
# 2. مطابقة الأنماط والتعابير النمطية (Regex)
# ----------------------------------------------------------------------------
اطبع("\n--- [2] محرك الأنماط والتعابير النمطية ---")

دع نص_سجل = "تواصل مع فريق التطوير على dev@lisan.org أو security@arabic-ai.io لطلب النسخة 104 أو 208"

دع محلل_بريد = جديد محلل_أنماط("[a-zA-Z0-9._+-]+@[a-zA-Z0-9.-]+\\.[a-zA-Z]+")
دع العناوين = محلل_بريد.استخرج(نص_سجل)
اطبع("عناوين البريد المستخرجة: " + نص(العناوين))
تحقق_يساوي(طول(العناوين)، 2)

دع الأرقام_المستخرجة = استخرج_نمط(نص_سجل، "\\d+")
اطبع("الأرقام المستخرجة: " + نص(الأرقام_المستخرجة))
تحقق_يساوي(الأرقام_المستخرجة، ["104"، "208"])

دع نص_محجوب = استبدل_نمط("رمز التحقق السري: 9842-1105"، "\\d+"، "****")
اطبع("بعد إخفاء الأرقام السرية: " + نص_محجوب)
تحقق_يساوي(نص_محجوب، "رمز التحقق السري: ****-****")
تحقق_صحيح(يطابق_نمط("مطور_لسان_2026"، "^\\w+$"))

# ----------------------------------------------------------------------------
# 3. معلومات النظام والمنصة والوقت الدقيق
# ----------------------------------------------------------------------------
اطبع("\n--- [3] معلومات النظام والمنصة ---")

دع النظام_الحالي = معلومات_النظام()
اطبع("نظام التشغيل: " + النظام_الحالي["النظام"] + " (" + النظام_الحالي["المعمارية"] + ")")
اطبع("عدد أنوية المعالج المتاحة: " + نص(النظام_الحالي["الأنوية"]))
اطبع("إصدار لغة لسان: " + النظام_الحالي["إصدار_لسان"])
تحقق_صحيح(النظام_الحالي["الأنوية"] >= 1)

انتظر_ثواني(0.005)

# ----------------------------------------------------------------------------
# 4. قاعدة البيانات المستديمة المدمجة (CRUD + JSON Persistence)
# ----------------------------------------------------------------------------
اطبع("\n--- [4] قاعدة البيانات المستديمة ---")

دع مسار_قاعدة = النظام_الحالي["مجلد_مؤقت"] + "/lisan_showcase_" + اقتطع(معرف_1، 0، 8) + ".json"
دع قاعدة = جديد قاعدة_بيانات(مسار_قاعدة)

قاعدة.أنشئ_جدول("المطورون")
قاعدة.أدرج("المطورون"، {"الاسم": "ليلى المنصور"، "التخصص": "أمن المعلومات"، "الخبرة": 7})
قاعدة.أدرج("المطورون"، {"الاسم": "طارق الزهراني"، "التخصص": "مترجمات"، "الخبرة": 9})
قاعدة.أدرج("المطورون"، {"الاسم": "سارة العتيبي"، "التخصص": "أمن المعلومات"، "الخبرة": 5})

اطبع("إجمالي المطورين المسجلين: " + نص(قاعدة.عدد_السجلات("المطورون")))
تحقق_يساوي(قاعدة.عدد_السجلات("المطورون")، 3)

دع مختصو_الأمن = قاعدة.ابحث_بحقل("المطورون"، "التخصص"، "أمن المعلومات")
اطبع("عدد مختصي أمن المعلومات: " + نص(طول(مختصو_الأمن)))
تحقق_يساوي(طول(مختصو_الأمن)، 2)

دع نتيجة_الحذف = قاعدة.احذف_بمعرف("المطورون"، 2)
تحقق_صحيح(نتيجة_الحذف)
تحقق_يساوي(قاعدة.عدد_السجلات("المطورون")، 2)

قاعدة.احفظ()
تحقق_صحيح(ملف_موجود(مسار_قاعدة))

# إعادة فتح قاعدة البيانات من القرص للتحقق من الاستدامة
دع قاعدة_مسترجعة = جديد قاعدة_بيانات(مسار_قاعدة)
اطبع("السجلات المسترجعة من القرص: " + نص(قاعدة_مسترجعة.الكل("المطورون")))
تحقق_يساوي(قاعدة_مسترجعة.عدد_السجلات("المطورون")، 2)

# تنظيف الملف المؤقت
احذف_ملف(مسار_قاعدة)

دع وقت_النهاية = وقت_دقيق_ملي()
دع المدة_بالملي = قرب((وقت_النهاية - وقت_البداية) * 100) / 100
اطبع("\nتم تنفيذ جميع الاختبارات والاستعراضات بنجاح في " + نص(المدة_بالملي) + " ملي ثانية!")
