# مثال بناء تطبيق هاتف ذكي متكامل مع الأيقونات والتصميمات
استورد "هاتف"

دع تطبيقي = جديد تطبيق_هاتف("بيتي الذكي"، "زمردي")

تطبيقي.أضف_إحصائية("درجة الحرارة"، "24°C"، "حرارة")
تطبيقي.أضف_بطاقة("لوحة الأردوينو متصلة"، "ESP32 متصلة عبر الواي فاي بنجاح"، "أردوينو")
تطبيقي.أضف_مفتاح_تحكم("إضاءة الصالة"، "شمس"، صحيح)
تطبيقي.أضف_مفتاح_تحكم("قفل الباب الذكي"، "قفل"، صحيح)
تطبيقي.أضف_زر("تفعيل وضع الحماية"، "درع"، "تم تفعيل وضع الحماية الشامل!")

اطبع(تطبيقي.بناء_واجهة())
