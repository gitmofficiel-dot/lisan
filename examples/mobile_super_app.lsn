# مثال بناء تطبيق هاتف شامل (Super App 2.0) متعددة الشاشات بلغة لسان
# يضم شاشات متعددة مع تبويبات سفلية، زر عائم (FAB)، نافذة سفلية (Bottom Sheet)، نموذج تفاعلي، ووضع ليلي/نهاري
# تشغيل: lisan --interpret examples/mobile_super_app.lsn

استورد "هاتف"

اطبع("=== جاري بناء تطبيق الهاتف الشامل (Super App 2.0) بلغة لسان ===")

دع تطبيق = جديد تطبيق_هاتف("سوبر لسان الذكي"، "لسان")
تطبيق.أيقونة_العنوان = "صاروخ"

# الشاشة 1: الرئيسية — ملخص سريع وإحصائيات وتقدم الأهداف
تطبيق.أضف_شاشة("home"، "الرئيسية"، "رئيسية"، [
    عنصر_إحصائية("رصيد المحفظة"، "2,450 ر.س"، "محفظة")،
    عنصر_إحصائية("نقاط المكافآت"، "890 نقطة"، "جائزة")،
    عنصر_شريط_تقدم("هدف الادخار الشهري"، 78)،
    عنصر_بطاقة("رحلتك القادمة"، "الرياض -> جدة • الساعة 08:30 مساءً"، "تقويم")،
    عنصر_زر("تحديث الرصيد الفوري"، "تحديث"، "تمت مزامنة بياناتك بنجاح!")
])

# الشاشة 2: المنزل الذكي — مفاتيح تحكم تفاعلية تحفظ حالتها في LocalStorage
تطبيق.أضف_شاشة("smart"، "المنزل"، "أردوينو"، [
    عنصر_إحصائية("حرارة الصالة"، "22.5°C"، "حرارة")،
    عنصر_مفتاح("إضاءة الصالة الرئيسية"، "مصباح"، صحيح)،
    عنصر_مفتاح("القفل الذكي للباب"، "قفل"، صحيح)،
    عنصر_مفتاح("المكيف التلقائي"، "واي_فاي"، خطأ)،
    عنصر_بطاقة("لوحة التحكم ESP32"، "متصلة بزمن استجابة 12 مللي ثانية"، "شريحة")
])

# الشاشة 3: المتجر والمدفوعات
تطبيق.أضف_شاشة("store"، "المتجر"، "متجر"، [
    عنصر_بطاقة("باقة لسان السحابية"، "49 ر.س / شهر • استضافة ومزامنة فورية"، "صاروخ")،
    عنصر_بطاقة("بطاقة الدفع الرقمية"، "مفعّلة للمشتريات الآمنة عبر NFC"، "بطاقة_دفع")،
    عنصر_زر("إتمام الطلب السريع"، "سلة"، "تمت إضافة العنصر إلى سلة المشتريات!")
])

# الشاشة 4: حسابي وإعدادات المستخدم
تطبيق.أضف_شاشة("profile"، "حسابي"، "مستخدم"، [
    عنصر_بطاقة("أحمد العتيبي"، "حساب موثّق • عضو منذ 2026"، "درع")،
    عنصر_مفتاح("الإشعارات الفورية"، "إشعار"، صحيح)،
    عنصر_مفتاح("القفل بالبصمة"، "قفل"، صحيح)،
    عنصر_زر("نسخ احتياطي للبيانات"، "سحابة"، "تم حفظ نسخة احتياطية مشفرة!")
])

# نموذج تفاعلي داخل نافذة سفلية (Bottom Sheet) يفتح عبر الزر العائم (FAB)
دع نموذج_سريع = "<form class=\"lsn-mobile-form\" onsubmit=\"handleMobileForm(event, 'quick_task', 'تمت إضافة المهمة وحفظها محلياً!')\"><div class=\"lsn-field\"><label>عنوان المهمة أو الطلب</label><input name=\"title\" type=\"text\" placeholder=\"مثال: تشغيل إضاءة الحديقة\" required></div><div class=\"lsn-field\"><label>التصنيف</label><input name=\"category\" type=\"text\" placeholder=\"المنزل الذكي / المتجر\" required></div><button class=\"lsn-btn\" type=\"submit\"><span>حفظ فوري</span></button></form>"

تطبيق.أضف_نافذة_سفلية("quick_add"، "إضافة إجراء سريع"، نموذج_سريع)
تطبيق.أضف_زر_عائم("إضافة"، "فتح قائمة الإضافة السريعة"، "quick_add")

# بناء واجهة HTML5 الكاملة للتطبيق والتحقق من جميع مكونات 2.0
دع واجهة_التطبيق = تطبيق.بناء_واجهة()

تحقق(يحتوي(واجهة_التطبيق، "<!DOCTYPE html>"))
تحقق(يحتوي(واجهة_التطبيق، "dir=\"rtl\""))
تحقق(يحتوي(واجهة_التطبيق، "phone-frame"))
تحقق(يحتوي(واجهة_التطبيق، "سوبر لسان الذكي"))
تحقق(يحتوي(واجهة_التطبيق، "id=\"screen-home\""))
تحقق(يحتوي(واجهة_التطبيق، "id=\"screen-smart\""))
تحقق(يحتوي(واجهة_التطبيق، "id=\"screen-store\""))
تحقق(يحتوي(واجهة_التطبيق، "id=\"screen-profile\""))
تحقق(يحتوي(واجهة_التطبيق، "selectScreen(this, 'home'"))
تحقق(يحتوي(واجهة_التطبيق، "selectScreen(this, 'store'"))
تحقق(يحتوي(واجهة_التطبيق، "lsn-fab"))
تحقق(يحتوي(واجهة_التطبيق، "id=\"sheet-quick_add\""))
تحقق(يحتوي(واجهة_التطبيق، "openBottomSheet('quick_add')"))
تحقق(يحتوي(واجهة_التطبيق، "toggleMobileTheme()"))
تحقق(يحتوي(واجهة_التطبيق، "lsnSaveState"))
تحقق(يحتوي(واجهة_التطبيق، "sw.js"))

اطبع("اسم التطبيق: " + تطبيق.اسم_التطبيق)
اطبع("عدد الشاشات المتاحة: " + نص(طول(تطبيق.الشاشات)))
اطبع("حجم واجهة التطبيق المولدة (حرف): " + نص(طول(واجهة_التطبيق)))
اطبع("تم التحقق من جميع مكونات تطبيق الهاتف الشامل 2.0 بنجاح! (لتصدير PWA كامل استدعِ: تطبيق.تصدير(\"تطبيق_سوبر\"))")
