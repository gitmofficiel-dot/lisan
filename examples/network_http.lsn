# مثال على شبكات لسان ومحاكاة خادم وبسيط
# تشغيل: lisan --interpret examples/network_http.lsn

استورد شبكة كـ ش

اطبع("=== مكتبة الشبكات في لسان ===")

# خادم ويب مصغر يعمل محلياً ويرد على المسارات المحددة
دع مسارات = {
    "/": "مرحباً بك في خادم لسان المدمج!",
    "/بيانات": "{\"رسالة\": \"نجاح\", \"حالة\": 200}",
    "/حالة": "الخادم يعمل بكفاءة عالية"
}

اطبع("تم تجهيز مسارات الخادم:")
اطبع(مسارات)
اطبع("يمكن تشغيل الخادم عبر: ش.خادم_ويب(8080، مسارات)")
اطبع("وطلب الروابط عبر: ش.طلب_وب(\"http://localhost:8080/بيانات\")")
