# وحدة التحكم الذكية على Raspberry Pi Pico W (RP2040 / MicroPython) بلغة لسان
استورد "بيكو"

اطبع("=== تشغيل متحكم راسبيري باي بيكو W الذكي (RP2040 Smart Edge Controller) ===")

# 1. فحص لوحة Raspberry Pi Pico W وتشغيل مصباح اللوحة
دع اللوحة = جديد لوحة_بيكو("Raspberry Pi Pico W")
اطبع("الطراز: " + اللوحة.اسم_الطراز())
اطبع("تردد المعالج: " + نص(اللوحة.تردد_المعالج_ميجا()) + " MHz | الذاكرة الحرة: " + نص(اللوحة.ذاكرة_حرة_كيلوبايت()) + " KB")
اللوحة.مصباح_اللوحة(صحيح)

# 2. التحكم في منافذ GPIO (مضخة ري وزر طوارئ بمقاومة سحب علوية)
دع مضخة_الري = جديد منفذ_بيكو(15، "مخرج")
دع زر_الطوارئ = جديد منفذ_بيكو(14، "مدخل"، "علوي")
مضخة_الري.شغّل()
اطبع("قراءة منفذ المضخة (GP15): " + نص(مضخة_الري.اقرأ()) + " | قراءة زر الطوارئ (GP14): " + نص(زر_الطوارئ.اقرأ()))

# 3. التحكم بسرعة مروحة التهوية عبر نبضة PWM بدقة 16 بت
دع مروحة_pwm = جديد نبضة_بيكو(16، 25000)
مروحة_pwm.اضبط_نسبة(65)
اطبع("تردد مروحة PWM: " + نص(مروحة_pwm.اضبط_تردد(25000)) + " Hz | نسبة التشغيل: 65%")

# 4. قراءة مستشعر رطوبة التربة عبر المحول التماثلي ADC (GP26)
دع حساس_رطوبة = جديد محول_تماثلي_بيكو(26)
حساس_رطوبة.ضبط_محاكاة(45875)
دع جهد_الحساس = حساس_رطوبة.اقرأ_جهد()
اطبع("قراءة ADC 16-bit: " + نص(حساس_رطوبة.اقرأ_16bit()) + " | الجهد المقاس: " + نص(جهد_الحساس) + " V")

# 5. مستشعر الحرارة الداخلي لشريحة RP2040 (ADC4)
دع حرارة_الشريحة = جديد مستشعر_حرارة_داخلي_بيكو()
حرارة_الشريحة.ضبط_محاكاة(32.4)
اطبع("حرارة شريحة RP2040: " + نص(حرارة_الشريحة.اقرأ_مئوية()) + "°C (" + نص(حرارة_الشريحة.اقرأ_فهرنهايت()) + "°F)")

# 6. ناقل I2C للتواصل مع شاشة OLED ومستشعر BME280
دع ناقل_i2c = جديد ناقل_i2c_بيكو(0، 0، 1، 400000)
ناقل_i2c.اكتب_بايت(118، 244، 39)
دع سجل_التهيئة = ناقل_i2c.اقرأ_بايت(118، 244)
اطبع("أجهزة I2C المكتشفة: " + نص(ناقل_i2c.فحص_الأجهزة().طول()) + " | قيمة سجل BME280: " + نص(سجل_التهيئة))

# 7. ناقل SPI لنقل البيانات عالية السرعة مع الذاكرة الخارجية
دع ناقل_spi = جديد ناقل_spi_بيكو(0، 2000000)
دع بيانات_spi = ناقل_spi.نقل([170، 85، 240، 15])
اطبع("طول حزمة SPI المسترجعة: " + نص(بيانات_spi.طول()) + " بايت")

# 8. منفذ UART للتواصل التسلسلي مع وحدة القياس
دع منفذ_تسلسلي = جديد منفذ_uart_بيكو(0، 115200، 0، 1)
منفذ_تسلسلي.اكتب("STATUS:TEMP=32.4,V=" + نص(جهد_الحساس))
منفذ_تسلسلي.ضبط_محاكاة("ACK:RECEIVED")
اطبع("رد منفذ UART: " + منفذ_تسلسلي.اقرأ_سطر())

# 9. الاتصال بشبكة Wi-Fi على Raspberry Pi Pico W
دع شبكة_بيكو = جديد واي_فاي_بيكو_w()
شبكة_بيكو.اتصل("Lisan_Greenhouse_WiFi"، "pico2040pass")
إذا (شبكة_بيكو.هل_متصل()) {
    اطبع("تم الاتصال بشبكة Wi-Fi بنجاح | عنوان IP: " + شبكة_بيكو.عنوان_ip())
}

# 10. شريط إضاءة NeoPixel RGB للإشارة البصرية لحالة النظام
دع شريط_ضوئي = جديد شريط_نيوبكسل_بيكو(28، 8)
إذا (حرارة_الشريحة.اقرأ_مئوية() > 30.0) {
    شريط_ضوئي.املأ(255، 120، 0)
    شريط_ضوئي.اضبط_مصباح(0، 255، 0، 0)
} وإلا {
    شريط_ضوئي.املأ(0، 255، 80)
}
شريط_ضوئي.اعرض()
اطبع("تم تحديث ألوان شريط NeoPixel RGB بنجاح.")

# 11. مؤقت العتاد الدوري لتسجيل النبضات
دع مؤقت_القياس = جديد مؤقت_بيكو(500)
مؤقت_القياس.ابدأ()
لكل دورة في مدى(4) {
    مؤقت_القياس.نبضة_محاكاة()
}
اطبع("عدد نبضات المؤقت الدورية: " + نص(مؤقت_القياس.عدد_النبضات()))

# 12. وحدة المعالجة القابلة للبرمجة PIO في RP2040
دع آلة_pio = جديد وحدة_pio_بيكو(0، 2000000، 2)
آلة_pio.فعّل()
آلة_pio.أرسل_كلمة(16711680)
آلة_pio.عطّل()
اطبع("تم إرسال كلمة 32-bit عبر وحدة PIO0 بنجاح.")

# إيقاف آمن للوحدات عند انتهاء دورة الفحص
مؤقت_القياس.أوقف()
مروحة_pwm.أوقف()
مضخة_الري.أوقف()
شبكة_بيكو.قطع_الاتصال()
اللوحة.مصباح_اللوحة(خطأ)

اطبع("=== اكتمل تشغيل متحكم Raspberry Pi Pico W بنجاح ===")
