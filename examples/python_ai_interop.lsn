# مثال التوافق البيني مع Python 3 والذكاء الاصطناعي والاتصال الآمن (HTTPS/TLS) بلغة لسان
# التشغيل: lisan examples/python_ai_interop.lsn

استورد "توافق"

اطبع("=== 1. استدعاء مكتبات Python 3 من لسان بالعربية ===")

إذا (بايثون_متوفر()) {
    # استدعاء مكتبة الرياضيات (math) في بايثون
    دع رياضيات = جديد مكتبة_بايثون("math")
    دع جذر_144 = رياضيات.استدعِ("sqrt"، [144])
    دع ثابت_ط = رياضيات.سمة("pi")
    دع تعبير_حسابي = رياضيات.تعبير("round(sqrt(16) + pi, 4)")

    اطبع(ن"جذر 144 عبر بايثون: {جذر_144}")
    اطبع(ن"قيمة ط عبر بايثون: {ثابت_ط}")
    اطبع(ن"نتيجة التعبير المباشر: {تعبير_حسابي}")

    # استدعاء مكتبة الإحصاء (statistics) في بايثون
    دع إحصاء = استورد_بايثون("statistics")
    دع درجات = [85، 92، 78، 96، 89، 94]
    دع متوسط_بايثون = إحصاء.استدعِ("mean"، [درجات])
    دع وسيط_بايثون = إحصاء.استدعِ("median"، [درجات])
    دع انحراف_بايثون = إحصاء.استدعِ("stdev"، [درجات])

    اطبع(ن"المتوسط الحسابي: {متوسط_بايثون}")
    اطبع(ن"الوسيط الإحصائي: {وسيط_بايثون}")
    اطبع(ن"الانحراف المعياري: {انحراف_بايثون}")

    # استدعاء مع معاملات مفتاحية (kwargs)
    دع جيسون_بايثون = جديد مكتبة_بايثون("json")
    دع نص_مرتب = جيسون_بايثون.استدعِ_بمفاتيح(
        "dumps"،
        [{"لغة": "لسان"، "توافق": "بايثون"}]،
        {"ensure_ascii": خطأ}
    )
    اطبع(ن"ترميز JSON عبر بايثون: {نص_مرتب}")
} وإلا {
    اطبع("مفسّر Python 3 غير مثبّت على هذا الجهاز.")
}

اطبع("")
اطبع("=== 2. عميل نماذج الذكاء الاصطناعي الموحّد (نموذج_ذكاء) ===")

دع مساعد_جيميني = جديد نموذج_ذكاء("جيميني"، "مفتاح_تجريبي_غير_مفعّل"، "gemini-2.0-flash")
مساعد_جيميني.ضبط_النظام("أنت خبير في لغة البرمجة العربية لسان.")
مساعد_جيميني.ضبط_الحرارة(0.4)

دع طلب_جيميني = مساعد_جيميني.بناء_طلب("اكتب وصفًا موجزًا للغة لسان.")
اطبع(ن"المزود: {طلب_جيميني["مزود"]} | النموذج: {طلب_جيميني["نموذج"]}")
اطبع(ن"الطريقة: {طلب_جيميني["طريقة"]}")
اطبع(ن"نص الرسالة داخل الطلب: {طلب_جيميني["جسم"]["contents"][0]["parts"][0]["text"]}")

دع مساعد_كلود = جديد عميل_ذكي("كلود"، "مفتاح_كلود_تجريبي")
دع طلب_كلود = مساعد_كلود.بناء_طلب("كيف تعمل الترجمة إلى بايثون وجافاسكربت؟")
اطبع(ن"المزود: {طلب_كلود["مزود"]} | النموذج: {طلب_كلود["نموذج"]}")

دع مساعد_محلي = جديد نموذج_ذكاء("محلي"، ""، "llama3.2")
دع طلب_محلي = مساعد_محلي.بناء_طلب("مرحبًا بالذكاء المحلي!")
اطبع(ن"نقطة النهاية المحلية: {طلب_محلي["رابط"]}")

اطبع("")
اطبع("=== 3. استعراض الاتصال الشبكي الآمن (طلب_شبكي_آمن - HTTPS/TLS) ===")
# عند توفر مفتاح حقيقي في متغير البيئة، يمكن استدعاء:
# دع رد_ذكي = مساعد_جيميني.اسأل("مرحبًا!")
# أو استخدام طلب_شبكي_آمن مباشرة:
دع مثال_طلب = {
    "طريقة": "GET"،
    "رابط": "https://api.github.com/zen"،
    "ترويسات": {"User-Agent": "Lisan-Lang/1.1"}
}
اطبع(ن"جاهز لتنفيذ طلب HTTPS آمن عبر: {مثال_طلب["طريقة"]} {مثال_طلب["رابط"]}")
اطبع("انتهى مثال التوافق البيني بنجاح.")
