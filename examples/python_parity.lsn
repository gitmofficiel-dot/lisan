# ========================================================
# مثال تكافؤ بايثون في لغة لسان (Lisan Python Parity Demo)
# ========================================================

# استيراد المكتبات بأسماء النطاقات (Namespaces) في أعلى الملف
استورد رياضيات كـ ر

# 1. النصوص المنسقة (f-strings)
دع اسم = "زيد"
دع عمر = 25
اطبع(ن"مرحباً بك يا {اسم}، عمرك الحالي {عمر} سنة")
اطبع(f"الحساب بعد خمس سنوات: {عمر + 5} سنة")

# 2. فك التعبئة المباشر (Unpacking)
دع نقطة_س، نقطة_ص = [100, 250]
اطبع(ن"الإحداثيات: س = {نقطة_س}، ص = {نقطة_ص}")

# 3. التقطيع العصري (Slicing)
دع أرقام = [10, 20, 30, 40, 50, 60]
اطبع("الأرقام من 1 إلى 4:")
اطبع(أرقام[1:4])
اطبع("الأرقام معكوسة:")
اطبع(أرقام[::-1])

# 4. التوليد المختصر للقوائم (List Comprehensions)
دع مربعات = [س * س لكل س في مدى(1, 6)]
اطبع("قائمة المربعات:")
اطبع(مربعات)

دع أعداد_زوجية = [ع لكل ع في أرقام إذا ع % 20 == 0]
اطبع("الأعداد التي تقبل القسمة على 20:")
اطبع(أعداد_زوجية)

# 5. معاملات الدوال المتغيرة (Varargs / *args)
دالة مجموع_شامل(*قيم) {
    دع إجمالي = 0
    لكل ق في قيم {
        إجمالي = إجمالي + ق
    }
    أرجع إجمالي
}
اطبع(ن"مجموع القيم: {مجموع_شامل(5, 10, 15, 20)}")

# 6. دوال بايثون التكرارية: مرقم (enumerate) وسحاب (zip)
دع فواكه = ["تفاح", "موز", "برتقال"]
لكل ترقيم، فاكهة في مرقم(فواكه) {
    اطبع(ن"العنصر رقم {ترقيم + 1} هو: {فاكهة}")
}

# 7. مدير السياق الآمن (with / مع)
دع ملف_الملاحظات = "/tmp/lisan_notes.txt"
مع افتح(ملف_الملاحظات, "ك") كـ ملف {
    ملف.اكتب("مرحباً من لسان العربي بمستوى بايثون!\n")
}

مع افتح(ملف_الملاحظات, "ق") كـ ملف {
    دع محتوى = ملف.اقرأ()
    اطبع("محتوى الملف المقروء عبر مدير السياق:")
    اطبع(محتوى)
}

# 8. استخدام وحدة الرياضيات المستوردة
اطبع(ن"قيمة ط (pi) = {ر.ط}")
اطبع(ن"جيب الزاوية 0 = {ر.جا(0)}")
اطبع(ن"الجذر التربيعي لـ 144 = {ر.جذر(144)}")
