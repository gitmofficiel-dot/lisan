// مثال يوضح كتابة كود لسان بأسلوب بايثون العصري: بدون فواصل منقوطة!

دالة ترحيب(اسم) {
    أرجع "مرحباً بك يا " + اسم + " في لغة لسان!"
}

ليكن درجات_الطلاب = {
    "أحمد": 95,
    "سارة": 88,
    "محمود": 72
}

لكل (اسم في مفاتيح(درجات_الطلاب)) {
    ليكن درجة = درجات_الطلاب[اسم]
    إذا (درجة >= 90) {
        اطبع(ترحيب(اسم) + " التقدير: ممتاز (" + درجة + ")")
    } وإلا {
        اطبع(اسم + ": جيد جداً (" + درجة + ")")
    }
}

// حساب إحصائيات سريعة بدون فواصل منقوطة
ليكن قائمة_الدرجات = قيم(درجات_الطلاب)
اطبع("المجموع: " + مجموع(قائمة_الدرجات))
اطبع("المتوسط: " + متوسط(قائمة_الدرجات))
اطبع("أعلى درجة: " + أعلى(قائمة_الدرجات[0], قائمة_الدرجات[1]))
