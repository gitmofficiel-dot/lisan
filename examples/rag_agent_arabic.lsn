# مثال شامل: الذكاء الاصطناعي الحديث والاسترجاع المعزّز (RAG) ووكلاء الأدوات واللوحة الموحّدة في لغة لسان
# 100% عربية خالصة — تعمل بالكامل دون اتصال بالإنترنت وبلا تبعيات خارجية
# التشغيل: lisan examples/rag_agent_arabic.lsn

استورد "وكلاء"

اطبع("=== 1. مخزن المتجهات الدلالي (مخزن_متجهات) ===")
دع مخزن = جديد مخزن_متجهات(64)
مخزن.أضف_مستند("برمجة_لسان"، "لغة البرمجة العربية لسان تدعم المفسّر والآلة الافتراضية والترجمة الأصيلة وتطوير الويب والذكاء الاصطناعي."، {"مجال": "البرمجة"})
مخزن.أضف_مستند("علوم_الفلك"، "يدرس علم الفلك النجوم والمجرات والكواكب السيارة وحركة الأجرام السماوية بالتلسكوبات الحديثة."، {"مجال": "الفلك"})
مخزن.أضف_مستند("علوم_الطب"، "يعتني الطب الحديث بتشخيص الأمراض وعلاج المرضى وتطوير اللقاحات والأدوية الدقيقة."، {"مجال": "الطب"})
مخزن.أضف_مستند("هندسة_الروبوتات"، "تجمع الروبوتات بين المحركات المؤازرة وحساسات المسافة وخوارزميات التحكم الذكي للذراع الآلي."، {"مجال": "الروبوتات"})

اطبع(ن"عدد المستندات المفهرسة: {مخزن.عدد()}")
دع أفضل_المطابقات = مخزن.ابحث("ما هي لغة البرمجة العربية لسان؟"، 2)
اطبع(ن"أقرب مستند: {أفضل_المطابقات[0]["معرف"]} (تشابه: {قرّب(أفضل_المطابقات[0]["تشابه"] * 1000) / 1000})")

اطبع("")
اطبع("=== 2. محرك الاسترجاع والتوليد المعزّز العربي (محرك_استرجاع_وتوليد) ===")
دع محرك = جديد محرك_استرجاع_وتوليد(مخزن)
دع سؤال = "ما هي لغة البرمجة العربية لسان؟"
دع إجابة = محرك.أجب(سؤال، 2)
اطبع(ن"السؤال: {سؤال}")
اطبع(ن"الإجابة المستخلصة: {إجابة}")

اطبع("")
اطبع("=== 3. الوكيل الذكي بالأدوات العربية وذاكرة المحادثة (وكيل_ذكي) ===")
دع وكيل = جديد وكيل_ذكي("المساعد_العربي"، "أنت وكيل ذكي تنفّذ الأدوات البحثية والحسابية بدقة.")

وكيل.أضف_أداة(
    "بحث_المعرفة"،
    "البحث في قاعدة المعرفة العربية عن إجابة موثقة"،
    دالة(استفسار) => محرك.أجب(استفسار، 2)
)
وكيل.أضف_أداة(
    "حساب_مساحة_مستطيل"،
    "حساب مساحة مستطيل بضرب الطول في العرض"،
    دالة(طول_ضلع، عرض_ضلع) => طول_ضلع * عرض_ضلع
)

دع تتبع_حساب = وكيل.فكّر_ونفّذ("احسب مساحة غرفة أبعادها 6 و 4 متر"، "حساب_مساحة_مستطيل"، [6، 4])
اطبع(ن"تفكير الوكيل: {تتبع_حساب["تفكير"]}")
اطبع(ن"نتيجة الأداة: {تتبع_حساب["نتيجة"]} متر مربع")

دع تتبع_بحث = وكيل.فكّر_ونفّذ("استرجع تعريف لغة لسان من قاعدة المعرفة"، "بحث_المعرفة"، ["لغة البرمجة العربية لسان"])
اطبع(ن"ملاحظة البحث: {تتبع_بحث["ملاحظة"]}")
اطبع(ن"عدد رسائل ذاكرة المحادثة: {وكيل.ذاكرة.عدد()}")

اطبع("")
اطبع("=== 4. موجّه بايتورش مع البديل المحلي الآمن (موجه_بايتورش) ===")
دع بايتورش = جديد موجه_بايتورش()
دع بطاقة_محرك = بايتورش.معلومات()
اطبع(ن"المحرك النشط: {بطاقة_محرك["المحرك"]} | الجهاز: {بطاقة_محرك["الجهاز"]}")
دع موتر_بيانات = بايتورش.موتر([[10، 20]، [30، 40]])
اطبع(ن"شكل الموتر: {موتر_بيانات["شكل"]} | المجموع: {موتر_بيانات["مجموع"]} | المتوسط: {موتر_بيانات["متوسط"]}")

اطبع("")
اطبع("=== 5. واجهة المتحكمات الدقيقة الموحّدة (لوحة_موحدة + منفذ_موحد) ===")
دع منصات_العتاد = ["أردوينو"، "إسب32"، "ستم32"، "راسبيري"، "بيكو"]
لكل منصة في منصات_العتاد {
    دع لوحة = جديد لوحة_موحدة(منصة)
    دع مصباح = لوحة.منفذ(13، "إخراج")
    دع حساس = لوحة.منفذ(2، "إدخال")
    مصباح.تشغيل()
    مصباح.نبضة(75)
    دع قراءة = حساس.قراءة_تماثلية()
    مصباح.إطفاء()
    دع ملخ = لوحة.ملخص()
    اطبع(ن"اللوحة: {ملخ["نوع_اللوحة"]} ({ملخ["المعمارية"]}) | قراءة تماثلية: {قراءة}/{ملخ["أقصى_قيمة_تماثلية"]} | عمليات مسجلة: {ملخ["عدد_العمليات"]}")
}
