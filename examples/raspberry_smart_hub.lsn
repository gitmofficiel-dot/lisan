# مركز الذكاء الاصطناعي وإنترنت الأشياء المتكامل على Raspberry Pi 5 بلغة لسان
استورد "راسبيري"

اطبع("=== تشغيل مركز راسبيري باي 5 الذكي (Lisan Smart AI & IoT Hub) ===")

# 1. معلومات وإدارة لوحة Raspberry Pi 5
دع اللوحة = جديد لوحة_راسبيري("Raspberry Pi 5")
اطبع("اللوحة: " + اللوحة.اسم_الطراز())
اطبع("عدد الأنوية: " + نص(اللوحة.عدد_الأنوية()) + " | الذاكرة المستهلكة: " + نص(اللوحة.استهلاك_الذاكرة_ميجا()) + " ميجابايت")
اطبع("حرارة المعالج: " + نص(اللوحة.حرارة_المعالج()) + "°C | عنوان الشبكة: " + اللوحة.عنوان_ip())

# 2. التحكم في منافذ GPIO (إضاءة الحالة وحساس الحركة PIR)
دع مصباح_الحالة = جديد منفذ_gpio_راسبيري(17، "مخرج")
دع حساس_الحركة = جديد منفذ_gpio_راسبيري(27، "مدخل"، "سفلي")

مصباح_الحالة.شغّل()
حساس_الحركة.ضبط_محاكاة(1)
اطبع("حالة مصباح النظام (BCM 17): " + نص(مصباح_الحالة.اقرأ()))

# 3. التحكم في سرعة مروحة التبريد عبر نبضات PWM
دع مروحة_التبريد = جديد نبضة_pwm_راسبيري(18، 25000)
مروحة_التبريد.ابدأ(45)
إذا (اللوحة.حرارة_المعالج() > 40.0) {
    مروحة_التبريد.غير_النسبة(75)
    اطبع("تم رفع سرعة مروحة التبريد PWM إلى 75%")
} وإلا {
    مروحة_التبريد.غير_النسبة(30)
}

# 4. فحص ناقل I2C والتخاطب مع الوحدات الطرفية (/dev/i2c-1)
دع ناقل_i2c = جديد ناقل_i2c_راسبيري(1)
ناقل_i2c.اكتب_بايت(60، 0، 175)
دع الأجهزة_المكتشفة = ناقل_i2c.فحص_الأجهزة()
اطبع("عدد أجهزة I2C المكتشفة على الناقل: " + نص(الأجهزة_المكتشفة.طول()))

# 5. قراءة البيئة والمصفوفة الضوئية عبر قبعة Sense HAT الرسمية
دع قبعة_الحساسات = جديد قبعة_الحساسات_sensehat()
دع حرارة_الغرفة = قبعة_الحساسات.اقرأ_حرارة()
دع رطوبة_الغرفة = قبعة_الحساسات.اقرأ_رطوبة()
دع الضغط_الجوي = قبعة_الحساسات.اقرأ_ضغط()
دع التوجيه = قبعة_الحساسات.اقرأ_توجيه()

اطبع("بيانات Sense HAT -> الحرارة: " + نص(حرارة_الغرفة) + "°C | الرطوبة: " + نص(رطوبة_الغرفة) + "% | الضغط: " + نص(الضغط_الجوي) + " hPa")
اطبع("زاوية الانعطاف (Yaw): " + نص(التوجيه["انعطاف"]))
قبعة_الحساسات.اضبط_بكسل(3، 3، 0، 255، 128)
قبعة_الحساسات.اعرض_رسالة("Lisan Pi 5"، 0.08)

# 6. توجيه ذراع الكاميرا الذكية عبر قبعة المحركات PCA9685 (16 قناة)
دع قبعة_المحركات = جديد قبعة_محركات_pca9685(64)
دع زوايا_المسح = [45، 90، 135، 90]
لكل زاوية في زوايا_المسح {
    قبعة_المحركات.اضبط_زاوية_سيرفو(0، زاوية)
}
قبعة_المحركات.اضبط_سرعة_محرك(1، 60)
اطبع("تم ضبط حامل الكاميرا على الزاوية 90 درجة وتشغيل محرك التهوية بنسبة 60%")

# 7. الرؤية الحاسوبية والتقاط الصور والبث عبر كاميرا CSI (Picamera2)
دع الكاميرا = جديد كاميرا_راسبيري(1920، 1080)
الكاميرا.ابدأ()

دع النظام_الصوتي = جديد صوت_راسبيري(85)
النظام_الصوتي.اضبط_الصوت(90)

إذا (حساس_الحركة.اقرأ() == 1) {
    اطبع("تنبيه أمني: تم رصد حركة في المدخل الرئيسي!")
    الكاميرا.التقط_صورة("/tmp/lisan_hub_intruder.jpg")
    الكاميرا.سجل_فيديو("/tmp/lisan_hub_event.mp4"، 5)
    الكاميرا.ابدأ_بث(8080)
    النظام_الصوتي.شغّل_ملف("/usr/share/sounds/alsa/Front_Center.wav")
    النظام_الصوتي.انطق_عربي("مرحباً بكم في مركز لسان الذكي على راسبيري باي خمسة، تم رصد حركة وتفعيل البث المباشر")
} وإلا {
    النظام_الصوتي.انطق_عربي("النظام في وضع المراقبة الهادئة")
}

# 8. عرض لوحة المعلومات على شاشة اللمس DSI وشاشة الحبر الإلكتروني e-Paper
دع شاشة_اللمس = جديد شاشة_لمس_dsi(7)
شاشة_اللمس.شغّل_الشاشة(صحيح)
شاشة_اللمس.اضبط_سطوع(85)

دع شاشة_الحبر = جديد شاشة_حبر_إلكتروني_epaper(250، 122)
شاشة_الحبر.امسح()
شاشة_الحبر.اعرض_نص(8، 10، "مركز لسان الذكي - Pi 5")
شاشة_الحبر.اعرض_نص(8، 40، "الحرارة: " + نص(حرارة_الغرفة) + " مئوية")
شاشة_الحبر.اعرض_نص(8، 70، "البث: منفذ 8080 نشط")
شاشة_الحبر.تحديث_الشاشة()
شاشة_الحبر.سكون()

# إغلاق آمن وتنظيف الموارد عند انتهاء الدورة الاختبارية
الكاميرا.أوقف()
مروحة_التبريد.أوقف()
قبعة_الحساسات.امسح_الشاشة()
مصباح_الحالة.أوقف()
مصباح_الحالة.تنظيف()
حساس_الحركة.تنظيف()

اطبع("=== اكتمل فحص وتشغيل جميع وحدات مركز Raspberry Pi 5 بنجاح ===")
