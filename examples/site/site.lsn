# موقع لسان الرسمي، مكتوب ومولَّد بلغة لسان نفسها
# التشغيل من جذر المستودع:  lisan --interpret examples/site/site.lsn
# الناتج: docs/index.html (جاهز للنشر عبر GitHub Pages)

استورد "موقع"

# نص ثنائي اللغة: عربي وإنجليزي، والتبديل بينهما في المتصفح
دالة ث(عربي، إنجليزي) {
    أرجع "<span class=\"ar\">" + عربي + "</span><span class=\"en\">" + إنجليزي + "</span>"
}

# تهريب رموز HTML ليظهر الكود كما هو
دالة هرّب(نص_خام) {
    دع ن = استبدل(نص_خام، "&"، "&amp;")
    ن = استبدل(ن، "<"، "&lt;")
    ن = استبدل(ن، ">"، "&gt;")
    أرجع ن
}

# كتلة كود من ملف مثال حقيقي في المستودع، مع الناتج المتوقع
دالة مثال(عنوان_ع، عنوان_إ، مسار، الناتج) {
    دع كود = هرّب(اقرأ_ملف(مسار))
    دع خرج = هرّب(الناتج)
    أرجع "<article class=\"ex\"><h3>" + ث(عنوان_ع، عنوان_إ) + "</h3><div class=\"file\">" + مسار + "</div><pre class=\"ar-code\"><code>" + كود + "</code></pre><div class=\"out-label\">" + ث("الناتج"، "Output") + "</div><pre class=\"ar-code out\"><code>" + خرج + "</code></pre></article>"
}

دع الرابط = "https://github.com/gitmofficiel-dot/lisan"
دع موقعي = جديد موقع_ويب("لسان | لغة البرمجة العربية — Lisan"، "ملكي")

# تنسيق إضافي: شريط علوي متجاوب، كتل الكود، وتبديل اللغة
دع نمط = "<style>"
نمط = نمط + "html[lang=en] .ar{display:none} html[lang=ar] .en{display:none}"
نمط = نمط + "html[lang=en]{direction:ltr} html[lang=en] body{direction:ltr}"
نمط = نمط + ".container{padding:16px} img,svg{max-width:100%}"
نمط = نمط + ".site-nav{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:12px 18px;position:sticky;top:10px;z-index:100;backdrop-filter:blur(10px)}"
نمط = نمط + ".site-nav .brand{font-weight:900;font-size:20px;color:var(--text);text-decoration:none}"
نمط = نمط + ".site-nav nav{display:flex;flex-wrap:wrap;gap:6px 16px}"
نمط = نمط + ".site-nav nav a{color:var(--muted);text-decoration:none;font-weight:600;font-size:14px}"
نمط = نمط + ".site-nav nav a:hover{color:var(--primary)}"
نمط = نمط + ".site-nav .tools{display:flex;gap:8px}"
نمط = نمط + ".hero2{background:linear-gradient(135deg,var(--surface),var(--surface-2));border:1px solid var(--border);border-radius:24px;padding:48px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px}"
نمط = نمط + ".hero2 h1{font-size:clamp(34px,8vw,54px);font-weight:900;line-height:1.15}"
نمط = نمط + ".hero2 p{color:var(--muted);max-width:680px;font-size:clamp(15px,3.6vw,18px);line-height:1.8}"
نمط = نمط + ".hero2 .cta{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}"
نمط = نمط + ".hero2 .code{direction:rtl;unicode-bidi:plaintext;text-align:right;background:#091d37;color:#f4f7fb;border-radius:14px;padding:14px 18px;font-family:ui-monospace,Consolas,monospace;font-size:15px;max-width:100%;overflow-x:auto}"
نمط = نمط + ".btn2{display:inline-flex;align-items:center;justify-content:center;padding:12px 24px;border-radius:14px;font-weight:700;text-decoration:none;color:#fff;background:linear-gradient(135deg,var(--primary),var(--accent))}"
نمط = نمط + ".btn2.ghost{background:transparent;color:var(--text);border:1px solid var(--border)}"
نمط = نمط + "section.block{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:24px 18px;display:flex;flex-direction:column;gap:14px;scroll-margin-top:90px}"
نمط = نمط + "section.block h2{font-size:clamp(22px,5vw,28px);font-weight:800}"
نمط = نمط + "section.block p{color:var(--muted)}"
نمط = نمط + ".steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:14px}"
نمط = نمط + ".lbl{font-weight:700;font-size:14px;margin-bottom:6px;color:var(--text)}"
نمط = نمط + "pre{direction:ltr;text-align:left;background:#091d37;color:#f4f7fb;border-radius:12px;padding:14px;overflow-x:auto;font-size:13.5px;line-height:1.6;max-width:100%}"
نمط = نمط + "pre.ar-code{direction:rtl;unicode-bidi:plaintext;text-align:right}pre.ar-code code{white-space:pre-wrap;word-break:break-word}"
نمط = نمط + ".sm a,.links a small{color:var(--primary)}.sm a{font-weight:700}"
نمط = نمط + "pre code{font-family:ui-monospace,Consolas,monospace;white-space:pre}"
نمط = نمط + "pre.out{background:#0d2748;color:#ffb98a}"
نمط = نمط + ".exs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:18px}"
نمط = نمط + ".ex{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:16px;min-width:0;display:flex;flex-direction:column;gap:8px}"
نمط = نمط + ".ex h3{font-size:17px}.ex pre{max-height:360px}"
نمط = نمط + ".file{font-family:ui-monospace,Consolas,monospace;font-size:12px;color:var(--muted);direction:ltr;text-align:left}"
نمط = نمط + ".out-label{font-size:12px;font-weight:700;color:var(--muted)}"
نمط = نمط + ".ex .file{display:flex;align-items:center;gap:6px;direction:ltr;font:12px ui-monospace,Consolas,monospace;color:var(--muted);background:#091d37;border:1px solid var(--border);border-bottom:0;border-radius:12px 12px 0 0;padding:8px 12px;margin-bottom:-8px}"
نمط = نمط + ".ex .file::before{content:'';width:9px;height:9px;border-radius:50%;background:#e65c1a;box-shadow:14px 0 0 #6f7f99,28px 0 0 #3a4d6d;margin-inline-end:34px}"
نمط = نمط + ".ex pre.ar-code{border-radius:0 0 12px 12px}.ex pre.out{border-radius:12px}"
نمط = نمط + ".ex{transition:transform .2s,border-color .2s,box-shadow .2s}.ex:hover{transform:translateY(-3px);border-color:var(--primary);box-shadow:0 10px 30px rgba(230,92,26,.18)}"
نمط = نمط + "section.block{margin-top:56px}.block h2{font-size:clamp(24px,4vw,34px);margin-bottom:10px}"
نمط = نمط + ".hero2{position:relative;overflow:hidden}.hero2::before{content:'';position:absolute;inset:-40% -10% auto;height:70%;background:radial-gradient(closest-side,rgba(230,92,26,.22),transparent);pointer-events:none}.hero2>*{position:relative}"
نمط = نمط + "pre{scrollbar-width:thin}.lbl{font-weight:700;margin-bottom:6px}"
نمط = نمط + ".path{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:14px;margin-top:12px}.path>*{display:flex;flex-direction:column;gap:6px;background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:16px;color:var(--text);text-decoration:none;min-width:0;transition:transform .2s,border-color .2s}.path>a:hover{transform:translateY(-3px);border-color:var(--primary)}.path small{color:var(--muted)}.path .n{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800}"
نمط = نمط + ":root{--bg:#ffffff;--surface:#ffffff;--surface-2:#f3f5f9;--text:#091d37;--muted:#44546e;--primary:#e65c1a;--accent:#f0803c;--border:#dbe1ea}html.dark{--bg:#091d37;--surface:#0e2646;--surface-2:#13335c;--text:#ffffff;--muted:#a9b9d2;--border:#244574}"
نمط = نمط + "body{background:var(--bg);color:var(--text)}.btn2{background:var(--primary)!important;box-shadow:0 6px 18px rgba(230,92,26,.28)}.btn2:hover{background:#cf4f13!important}.btn2.ghost{background:transparent!important;box-shadow:none;border:1px solid var(--text);color:var(--text)}"
نمط = نمط + ".site-nav .brand{display:flex;align-items:center;gap:10px}.site-nav .brand img{height:38px;width:auto}.hero2 .logo{width:min(220px,50%);height:auto;border-radius:20px;background:#fff;padding:10px;box-shadow:0 8px 24px rgba(9,29,55,.12)}.path .n{background:var(--primary)}.hero2{background:var(--surface-2)}.hero2 h1{color:var(--text)}.ex .file{color:#a9b9d2}.ex .out-label{color:var(--primary)}h2{border-inline-start:5px solid var(--primary);padding-inline-start:12px}"
نمط = نمط + "body{background-color:#fff;background-image:radial-gradient(rgba(9,29,55,.07) 1px,transparent 1px);background-size:22px 22px}"
نمط = نمط + ".site-nav{position:sticky;top:10px;z-index:50;background:rgba(255,255,255,.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 8px 28px rgba(9,29,55,.08);border-color:rgba(9,29,55,.08)}"
نمط = نمط + ".site-nav nav a{position:relative;padding:4px 2px}.site-nav nav a::after{content:'';position:absolute;inset-inline:0;bottom:-2px;height:2px;background:var(--primary);transform:scaleX(0);transition:transform .2s}.site-nav nav a:hover::after{transform:scaleX(1)}"
نمط = نمط + ".hero2{background:radial-gradient(circle at 50% 0,rgba(230,92,26,.35),transparent 55%),linear-gradient(160deg,#0d2748,#091d37 70%);border:0;color:#fff;padding:64px 20px 56px;box-shadow:0 24px 60px rgba(9,29,55,.28)}"
نمط = نمط + ".hero2::before{display:none}.hero2::after{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.07) 1px,transparent 1px);background-size:20px 20px;pointer-events:none}"
نمط = نمط + ".hero2>*{position:relative;z-index:1}.hero2 h1{color:#fff;font-size:clamp(44px,10vw,84px);letter-spacing:-1px}.hero2 p{color:#c9d5e8}"
نمط = نمط + ".hero2 .logo{box-shadow:0 0 0 6px rgba(230,92,26,.35),0 18px 40px rgba(0,0,0,.35)}"
نمط = نمط + ".hero2 .code{background:#06142a;border:1px solid rgba(255,255,255,.12);border-inline-start:4px solid var(--primary);box-shadow:0 12px 30px rgba(0,0,0,.3)}"
نمط = نمط + ".hero2 .btn2.ghost{color:#fff;border-color:rgba(255,255,255,.55)}.hero2 .btn2.ghost:hover{background:rgba(255,255,255,.1)}"
نمط = نمط + ".btn2{transition:transform .15s,box-shadow .15s,background .15s}.btn2:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(230,92,26,.38)}"
نمط = نمط + ".web-grid{gap:18px;margin-top:28px}"
نمط = نمط + ".lsn-card{background:#fff;border:1px solid var(--border);border-top:4px solid var(--primary);border-radius:18px;box-shadow:0 6px 20px rgba(9,29,55,.06);transition:transform .2s,box-shadow .2s}"
نمط = نمط + ".lsn-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(9,29,55,.14)}"
نمط = نمط + ".lsn-card-icon{background:var(--primary)!important;border-radius:14px}.lsn-card-icon svg,.lsn-icon{color:#fff!important;stroke:#fff!important}"
نمط = نمط + "section.block{background:transparent;border:0;border-radius:0;padding:8px 4px;box-shadow:none}"
نمط = نمط + ".block h2{font-size:clamp(26px,4.5vw,38px);font-weight:900}"
نمط = نمط + ".path>*,.links a,.ex{background:#fff;box-shadow:0 6px 20px rgba(9,29,55,.06);transition:transform .2s,box-shadow .2s,border-color .2s}"
نمط = نمط + ".path>*:hover,.links a:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(9,29,55,.12);border-color:var(--primary)}"
نمط = نمط + "#install,#playground{background:linear-gradient(160deg,#0d2748,#091d37);color:#fff;border-radius:26px;padding:36px 22px!important;box-shadow:0 20px 50px rgba(9,29,55,.25);position:relative;overflow:hidden}"
نمط = نمط + "#playground::before{content:'';position:absolute;width:320px;height:320px;inset-inline-start:-80px;top:-120px;background:radial-gradient(closest-side,rgba(230,92,26,.45),transparent);pointer-events:none}"
نمط = نمط + "#install h2,#playground h2,#install .lbl{color:#fff}#install p,#playground p,#install .sm{color:#c9d5e8}#install a{color:#ffb98a}"
نمط = نمط + "#install pre{background:#06142a;border:1px solid rgba(255,255,255,.12)}"
نمط = نمط + "#playground .btn2{align-self:flex-start}"
نمط = نمط + ".web-footer{background:#091d37;color:#c9d5e8;border-radius:22px;padding:26px 18px;margin-top:56px;border:0}.web-footer a{color:#ffb98a}.web-footer p{color:#c9d5e8}"
نمط = نمط + "::selection{background:#e65c1a;color:#fff}"
نمط = نمط + ".stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:0;background:#fff;border:1px solid var(--border);border-radius:22px;margin-top:22px;box-shadow:0 6px 20px rgba(9,29,55,.06)}.stats>div{padding:22px 10px;text-align:center;border-inline-end:1px solid var(--border)}.stats>div:last-child{border:0}.stats b{display:block;font-size:clamp(34px,6vw,52px);font-weight:900;color:var(--primary);line-height:1.1}.stats small{color:var(--muted);font-weight:600}"
نمط = نمط + ".tabs{display:flex;flex-wrap:wrap;gap:10px;margin:6px 0 4px}.tab{border:0;cursor:pointer;font:inherit;font-weight:700;padding:10px 20px;border-radius:999px;background:#13335c;color:#fff;transition:background .15s}.tab[aria-selected=true]{background:var(--primary)}"
نمط = نمط + ".show{display:none;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px}.show.on{display:grid}.show pre{font-family:ui-monospace,Consolas,monospace;margin:0;background:#06142a;border:1px solid rgba(255,255,255,.12)}.show .res{background:#0d2748;border-radius:12px;padding:14px;color:#ffb98a;font:13.5px/1.7 ui-monospace,Consolas,monospace;direction:rtl;text-align:right;white-space:pre-wrap}.show .res i{display:block;font-style:normal;font-weight:700;color:var(--primary);margin-bottom:6px;font-family:inherit}"
نمط = نمط + "#showcase{background:linear-gradient(160deg,#0d2748,#091d37);color:#fff;border-radius:26px;padding:36px 22px!important;box-shadow:0 20px 50px rgba(9,29,55,.25)}#showcase h2{color:#fff}"
نمط = نمط + ".btn2,.btn2:hover{color:#fff}.btn2{background:#c2410c!important}.btn2:hover{background:#a8360a!important}.btn2.ghost{background:transparent!important}"
نمط = نمط + ".sm a,.links a small,.path a{color:#c2410c}html.dark .sm a,html.dark .links a small{color:#ffb98a}"
نمط = نمط + "#install a,#showcase a{color:#ffb98a}"
نمط = نمط + ".file,.out-label{font-size:13px}.sm{font-size:14px}"
نمط = نمط + ".tab{border:1px solid #3d5b85}.tab[aria-selected=true]{border-color:var(--primary);box-shadow:0 2px 0 #fff inset}"
نمط = نمط + "a:focus-visible,button:focus-visible,.tab:focus-visible{outline:3px solid #ffb98a;outline-offset:2px;border-radius:8px}"
نمط = نمط + "@media(max-width:720px){.site-nav{flex-wrap:wrap;gap:8px 10px;padding:10px 14px}.site-nav .tools{margin-inline-start:auto}.site-nav nav{order:3;flex:1 1 100%;flex-wrap:wrap;justify-content:center;gap:6px}.site-nav nav a{background:var(--surface-2);border-radius:999px;padding:6px 12px;font-size:13px}.site-nav nav a::after{display:none}.site-nav .brand span{display:none}.site-nav .tools{flex:none}.hero2 .logo{width:min(140px,38%)}.hero2{padding-block:28px}}"
نمط = نمط + "@media(max-width:480px){section.block{margin-top:36px}.ex{padding:12px}pre{font-size:12.5px}}"
نمط = نمط + ".links{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px}"
نمط = نمط + ".links a{display:block;background:var(--surface-2);border:1px solid var(--border);border-radius:14px;padding:14px 16px;color:var(--text);text-decoration:none;font-weight:700}"
نمط = نمط + ".links a small{display:block;color:var(--muted);font-weight:500;margin-top:4px}"
نمط = نمط + ".links a:hover{border-color:var(--primary)}"
نمط = نمط + ".lsn-card-body{min-width:0}.web-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}"
نمط = نمط + ".sm{font-size:13px;color:var(--muted)}"
نمط = نمط + "</style>"
موقعي.أضف_عنصر(نمط)

# الشريط العلوي
دع شريط = "<header class=\"site-nav\"><a class=\"brand\" href=\"#top\"><img src=\"logo.png\" alt=\"Lisan logo\"><span>لسان · Lisan</span></a><nav>"
شريط = شريط + "<a href=\"#features\">" + ث("المزايا"، "Features") + "</a>"
شريط = شريط + "<a href=\"#start\">" + ث("ابدأ"، "Start") + "</a>"
شريط = شريط + "<a href=\"#install\">" + ث("التثبيت"، "Install") + "</a>"
شريط = شريط + "<a href=\"#examples\">" + ث("أمثلة"، "Examples") + "</a>"
شريط = شريط + "<a href=\"#playground\">" + ث("التجربة"، "Playground") + "</a>"
شريط = شريط + "<a href=\"#docs\">" + ث("الوثائق"، "Docs") + "</a><a href=\"#community\">" + ث("المجتمع"، "Community") + "</a></nav>"
شريط = شريط + "<div class=\"tools\"><button class=\"theme-toggle-btn\" onclick=\"toggleTheme()\">" + ث("الوضع"، "Theme") + "</button><button class=\"theme-toggle-btn\" onclick=\"toggleLang()\" aria-label=\"Language\"><span class=\"ar\">EN</span><span class=\"en\">عربي</span></button></div></header>"
موقعي.أضف_عنصر(شريط)

# القسم الرئيسي
دع رئيسي = "<section id=\"top\" class=\"hero2\"><img class=\"logo\" src=\"logo.png\" alt=\"شعار لسان Lisan logo\"><h1>" + ث("لسان"، "Lisan") + "</h1>"
رئيسي = رئيسي + "<p>" + ث("لغة برمجة عربية فصيحة مكتوبة بلغة Rust. اكتب بكلمات عربية وأرقام عربية وغربية وفارسية، وشغّلها بمفسّر أو آلة افتراضية، أو ترجمها إلى كود آلة أصلي عبر LLVM."، "An Arabic programming language written in Rust. Write with Arabic keywords and identifiers, use Western, Arabic-Indic or Persian digits, run it on an interpreter or VM, or compile natively through LLVM.") + "</p>"
رئيسي = رئيسي + "<div class=\"code\">دع الاسم = \"العالم\"؛<br>اطبع(\"مرحبا يا \" + الاسم + \"!\")؛</div>"
رئيسي = رئيسي + "<div class=\"cta\"><a class=\"btn2\" href=\"#install\">" + ث("ابدأ التثبيت"، "Get started") + "</a><a class=\"btn2 ghost\" href=\"playground/\">" + ث("جرّب في المتصفح"، "Try in the browser") + "</a><a class=\"btn2 ghost\" href=\"" + الرابط + "\">GitHub</a></div></section>"
موقعي.أضف_عنصر(رئيسي)

# شريط الأرقام (فكرة من python.org)
دع أرقام = "<div class=\"stats\"><div><b>83</b><small>" + ث("وحدة عتاد"، "hardware modules") + "</small></div><div><b>3</b><small>" + ث("طرق تنفيذ"، "execution paths") + "</small></div><div><b>3</b><small>" + ث("أنظمة أرقام"، "numeral systems") + "</small></div><div><b>MIT</b><small>" + ث("رخصة مفتوحة"، "open license") + "</small></div></div>"
موقعي.أضف_عنصر(أرقام)

# عرض الكود بالتبويبات (فكرة من python.org: أمثلة تفاعلية)
دع عرض = "<section id=\"showcase\" class=\"block\"><h2>" + ث("جرّب لسان بنظرة"، "Lisan at a glance") + "</h2><div class=\"tabs\" role=\"tablist\">"
عرض = عرض + "<button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-t=\"0\">" + ث("أول برنامج"، "First program") + "</button><button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-t=\"1\">" + ث("الدوال"، "Functions") + "</button><button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-t=\"2\">" + ث("القوائم"، "Lists") + "</button></div>"
عرض = عرض + "<div class=\"show on\" data-t=\"0\"><pre class=\"ar-code\">دع الاسم = \"العالم\"؛\nاطبع(\"مرحبا يا \" + الاسم + \"!\")؛</pre><div class=\"res\"><i>" + ث("الناتج"، "Output") + "</i>مرحبا يا العالم!</div></div>"
عرض = عرض + "<div class=\"show\" data-t=\"1\"><pre class=\"ar-code\">دالة مضروب(ن) {\n    إذا (ن &lt;= 1) {\n        أرجع 1؛\n    }\n    أرجع ن * مضروب(ن - 1)؛\n}\nاطبع(\"مضروب 5 = \" + مضروب(5))؛</pre><div class=\"res\"><i>" + ث("الناتج"، "Output") + "</i>مضروب 5 = 120</div></div>"
عرض = عرض + "<div class=\"show\" data-t=\"2\"><pre class=\"ar-code\">دع قياسات = [18، 21، 24]؛\nدع المجموع = 0؛\nلكل (قيمة في قياسات) {\n    المجموع = المجموع + قيمة؛\n}\nاطبع(\"المجموع: \" + المجموع)؛\nاطبع(\"عدد القياسات: \" + طول(قياسات))؛</pre><div class=\"res\"><i>" + ث("الناتج"، "Output") + "</i>المجموع: 63\nعدد القياسات: 3</div></div>"
عرض = عرض + "<p class=\"sm\" style=\"color:#c9d5e8\">" + ث("المخرجات حقيقية: شغّلناها بمفسّر لسان."، "Outputs are real: we ran them with the Lisan interpreter.") + "</p></section>"
موقعي.أضف_عنصر(عرض)

# المزايا (من الشبكة الجاهزة في مكتبة موقع)
موقعي.أضف_شبكة([
    [ث("كلمات عربية وكتابة من اليمين"، "Arabic keywords, right to left"), ث("المعرّفات والكلمات المفتاحية عربية، مع دعم النصوص ثنائية الاتجاه."، "Identifiers and keywords are Arabic, with bidirectional text support."), "كود"],
    [ث("ثلاثة أنظمة للأرقام"، "Three digit systems"), ث("الأرقام الغربية 0-9 والعربية ٠-٩ والفارسية ۰-۹ بالتساوي: 42 = ٤٢ = ۴۲."، "Western 0-9, Arabic-Indic ٠-٩ and Persian ۰-۹ are equal: 42 = ٤٢ = ۴۲."), "شريحة"],
    [ث("ثلاث طرق للتنفيذ"، "Three ways to run"), ث("مفسّر مباشر، آلة بايت كود افتراضية، أو ترجمة أصلية عبر LLVM وClang."، "A direct interpreter, a bytecode VM, or native compilation via LLVM and Clang."), "روبوت"],
    [ث("المتحكمات والعتاد"، "Embedded targets"), ث("تصدير إلى Arduino وESP32 وSTM32 وRaspberry Pi."، "Export to Arduino, ESP32, STM32 and Raspberry Pi."), "أردوينو"],
    [ث("ويب وهاتف"، "Web and mobile"), ث("مكتبة لبناء صفحات الويب وتطبيقات PWA، وهذا الموقع مبني بها."، "A library for web pages and PWA apps. This very site is built with it."), "هاتف"],
    [ث("أدوات كاملة"، "Full tooling"), ث("منسّق، إطار اختبارات، خادم لغة LSP، مدير حزم، وإضافة VS Code."، "Formatter, test runner, LSP server, package manager and a VS Code extension."), "درع"]
])

# ابدأ من هنا (نمط دليل المبتدئ)
دع بداية = "<section id=\"start\" class=\"block\"><h2>" + ث("ابدأ من هنا"، "Start here") + "</h2><div class=\"path\">"
بداية = بداية + "<a href=\"#install\"><span class=\"n\">1</span><b>" + ث("ثبّت لسان"، "Install Lisan") + "</b><small>" + ث("أمر واحد لكل نظام"، "One command per platform") + "</small></a>"
بداية = بداية + "<a href=\"#examples\"><span class=\"n\">2</span><b>" + ث("اقرأ مثالًا يعمل"، "Read a working example") + "</b><small>" + ث("أول برنامج في ثلاثة أسطر"، "Your first program in three lines") + "</small></a>"
بداية = بداية + "<a href=\"playground/\"><span class=\"n\">3</span><b>" + ث("جرّبه في المتصفح"، "Try it in the browser") + "</b><small>" + ث("بلا تثبيت"، "No install") + "</small></a>"
بداية = بداية + "<a href=\"#docs\"><span class=\"n\">4</span><b>" + ث("تعمّق في الوثائق"، "Go deeper in the docs") + "</b><small>" + ث("القواعد والمترجم"، "Syntax and compiler") + "</small></a></div></section>"
موقعي.أضف_عنصر(بداية)

# الاستخدامات (نمط تطبيقات بايثون)
دع استخدامات = "<section id=\"uses\" class=\"block\"><h2>" + ث("ماذا تبني بلسان؟"، "What can you build with Lisan?") + "</h2><div class=\"path\">"
استخدامات = استخدامات + "<div><b>" + ث("التعلّم والتعليم"، "Learning and teaching") + "</b><small>" + ث("برمجة بكلمات عربية، ومفسّر مباشر"، "Programming in Arabic words with a direct interpreter") + "</small></div>"
استخدامات = استخدامات + "<div><b>" + ث("المتحكمات"، "Microcontrollers") + "</b><small>Arduino · ESP32 · STM32 · Raspberry Pi</small></div>"
استخدامات = استخدامات + "<div><b>" + ث("الويب والتطبيقات"، "Web and apps") + "</b><small>" + ث("مكتبة موقع، وهذه الصفحة مبنية بها"، "A web library; this page is built with it") + "</small></div>"
استخدامات = استخدامات + "<div><b>" + ث("أدوات المطوّر"، "Developer tools") + "</b><small>" + ث("منسّق، اختبارات، خادم LSP، VS Code"، "Formatter, tests, LSP server, VS Code") + "</small></div></div></section>"
موقعي.أضف_عنصر(استخدامات)

# التثبيت
دع تثبيت = "<section id=\"install\" class=\"block\"><h2>" + ث("التثبيت"، "Install") + "</h2><div class=\"steps\">"
تثبيت = تثبيت + "<div><div class=\"lbl\">Linux · macOS · Raspberry Pi</div><pre><code>curl -sSf https://raw.githubusercontent.com/gitmofficiel-dot/lisan/main/install.sh | sh</code></pre></div>"
تثبيت = تثبيت + "<div><div class=\"lbl\">Windows (PowerShell)</div><pre><code>irm https://raw.githubusercontent.com/gitmofficiel-dot/lisan/main/install.ps1 | iex</code></pre></div>"
تثبيت = تثبيت + "<div><div class=\"lbl\">" + ث("من المصدر"، "From source") + " (Rust)</div><pre><code>git clone " + الرابط + ".git\ncd lisan\ncargo run -- examples/hello.lsn</code></pre></div>"
تثبيت = تثبيت + "<div><div class=\"lbl\">" + ث("تشغيل ملف"، "Run a file") + "</div><pre><code>lisan --interpret examples/hello.lsn</code></pre></div></div>"
تثبيت = تثبيت + "<p class=\"sm\">" + ث("حزم جاهزة لكل الأنظمة في صفحة"، "Prebuilt packages for every platform are on the") + " <a href=\"" + الرابط + "/releases/latest\">Releases</a>.</p></section>"
موقعي.أضف_عنصر(تثبيت)

# أمثلة حقيقية من المستودع
دع أمثلة = "<section id=\"examples\" class=\"block\"><h2>" + ث("أمثلة حقيقية"، "Real examples") + "</h2><p>" + ث("هذه الملفات من مجلد examples في المستودع، وقد شغّلناها بالإصدار 1.0.0."، "These files come from the examples folder in the repository and were run with version 1.0.0.") + "</p><div class=\"exs\">"
أمثلة = أمثلة + مثال("أول برنامج"، "Hello"، "examples/hello.lsn"، "مرحبا يا العالم!\nعددنا: 12")
أمثلة = أمثلة + مثال("دالة تعيد نفسها"، "A recursive function"، "examples/functions.lsn"، "مضروب 5 = 120")
أمثلة = أمثلة + مثال("قوائم وحلقات"، "Lists and loops"، "examples/lists.lsn"، "المجموع: 90\nعدد القياسات: 4\nالقياس الثاني: 22\nهل يوجد 26؟ صحيح")
أمثلة = أمثلة + مثال("أصناف وكائنات"، "Classes and objects"، "examples/oop_car.lsn"، "تم إنشاء الكائن من صنف: سيارة\nسيارة تسلا تسير بسرعة: 0 كم/س\n--- تسارع بمقدار 80 ---\nسيارة تسلا تسير بسرعة: 80 كم/س\n...")
أمثلة = أمثلة + "</div></section>"
موقعي.أضف_عنصر(أمثلة)

# التجربة في المتصفح
دع تجربة = "<section id=\"playground\" class=\"block\"><h2>" + ث("التجربة في المتصفح"، "Playground") + "</h2><p>" + ث("استوديو لسان يعمل داخل المتصفح بمفسّر WebAssembly، بلا تثبيت."، "Lisan Studio runs in your browser on a WebAssembly interpreter, with no install.") + "</p><div class=\"cta\"><a class=\"btn2\" href=\"playground/\">" + ث("افتح الاستوديو"، "Open the Studio") + "</a></div></section>"
موقعي.أضف_عنصر(تجربة)

# الوثائق
دع وثائق = "<section id=\"docs\" class=\"block\"><h2>" + ث("الوثائق"، "Documentation") + "</h2><div class=\"links\">"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/docs/SYNTAX.md\">" + ث("قواعد اللغة"، "Syntax") + "<small>docs/SYNTAX.md</small></a>"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/docs/NUMBERS-AND-STYLE.md\">" + ث("الأرقام والأسلوب"، "Numbers and style") + "<small>docs/NUMBERS-AND-STYLE.md</small></a>"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/docs/EXECUTION-PATHS.md\">" + ث("مسارات التنفيذ"، "Execution paths") + "<small>docs/EXECUTION-PATHS.md</small></a>"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/docs/NATIVE-COMPILER.md\">" + ث("المترجم الأصلي"، "Native compiler") + "<small>docs/NATIVE-COMPILER.md</small></a>"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/docs/ROADMAP.md\">" + ث("خارطة الطريق"، "Roadmap") + "<small>docs/ROADMAP.md</small></a>"
وثائق = وثائق + "<a href=\"" + الرابط + "/blob/main/CONTRIBUTING.md\">" + ث("المساهمة"، "Contributing") + "<small>CONTRIBUTING.md</small></a>"
وثائق = وثائق + "</div></section>"
موقعي.أضف_عنصر(وثائق)

# المجتمع والمساهمة (نمط مجتمع بايثون)
دع مجتمع = "<section id=\"community\" class=\"block\"><h2>" + ث("المجتمع"، "Community") + "</h2><p>" + ث("لسان مشروع مفتوح ويكبر بمساهمات الناس. المبتدئ والخبير مرحّب بهما."، "Lisan is open and grows with contributions. Beginners and experts are welcome.") + "</p><div class=\"links\">"
مجتمع = مجتمع + "<a href=\"" + الرابط + "/issues/new/choose\">" + ث("أبلغ عن مشكلة أو اقترح ميزة"، "Report a bug or suggest a feature") + "<small>GitHub Issues</small></a>"
مجتمع = مجتمع + "<a href=\"" + الرابط + "/blob/main/CONTRIBUTING.md\">" + ث("ساهم بالكود"، "Contribute code") + "<small>CONTRIBUTING.md</small></a>"
مجتمع = مجتمع + "<a href=\"" + الرابط + "\">" + ث("ضع نجمة على المستودع"، "Star the repository") + "<small>GitHub</small></a>"
مجتمع = مجتمع + "<a href=\"" + الرابط + "/blob/main/LICENSE\">" + ث("الرخصة المفتوحة"، "Open license") + "<small>MIT</small></a>"
مجتمع = مجتمع + "</div></section>"
موقعي.أضف_عنصر(مجتمع)

# تذييل وسكربت التبديل
دع تذييل = "<footer class=\"web-footer\"><p>" + ث("لسان مفتوحة المصدر برخصة MIT."، "Lisan is open source under the MIT license.") + "</p><p class=\"sm\">" + ث("هذه الصفحة مولَّدة بلغة لسان:"، "This page is generated by Lisan itself:") + " <a href=\"" + الرابط + "/blob/main/examples/site/site.lsn\">examples/site/site.lsn</a></p></footer>"
موقعي.أضف_عنصر(تذييل)
دع سكربت = "<script>document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('.tab');if(!b)return;var n=b.getAttribute('data-t');document.querySelectorAll('.tab').forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false')});document.querySelectorAll('.show').forEach(function(x){x.classList.toggle('on',x.getAttribute('data-t')===n)})});function toggleTheme(){var d=document.documentElement;d.classList.toggle('dark');try{localStorage.setItem('lsn_theme',d.classList.contains('dark')?'dark':'light')}catch(e){}}try{if(localStorage.getItem('lsn_theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}function toggleLang(){var h=document.documentElement;var n=h.lang==='ar'?'en':'ar';setLang(n);}"
سكربت = سكربت + "function setLang(l){var h=document.documentElement;h.lang=l;h.dir=l==='ar'?'rtl':'ltr';try{localStorage.setItem('lsn_lang',l)}catch(e){}}"
سكربت = سكربت + "try{var s=localStorage.getItem('lsn_lang');if(s)setLang(s)}catch(e){}</script>"
موقعي.أضف_عنصر(سكربت)

موقعي.حفظ("docs/index.html")
اطبع("تم توليد docs/index.html")
