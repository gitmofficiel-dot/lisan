# مثال على العمليات الرياضية المتقدمة والإحصاء في لسان
# تشغيل: lisan --interpret examples/statistics_demo.lsn

استورد رياضيات كـ ر
استورد إحصاء كـ ح

اطبع("=== 1. العمليات الرياضية المتقدمة ===")
اطبع("مضروب العدد 6: " + نص(ر.مضروب(6)))
اطبع("قاسم مشترك (36، 24): " + نص(ر.قاسم_مشترك(36، 24)))
اطبع("مضاعف مشترك (15، 20): " + نص(ر.مضاعف_مشترك(15، 20)))
اطبع("توافيق 8 عناصر نختار منها 3 (8C3): " + نص(ر.توافيق(8، 3)))
اطبع("تباديل 8 عناصر نختار منها 3 (8P3): " + نص(ر.تباديل(8، 3)))
اطبع("لوغاريتم 1000 للأساس 10: " + نص(ر.لوغاريتم10(1000)))
اطبع("لوغاريتم 1024 للأساس 2: " + نص(ر.لوغاريتم2(1024)))

اطبع("\n=== 2. التحليل الإحصائي للبيانات ===")
دع درجات_الطلاب = [85، 90، 78، 92، 88، 90، 95، 82]
اطبع("عينة الدرجات: " + نص(درجات_الطلاب))
اطبع("المتوسط الحسابي: " + نص(ح.متوسط(درجات_الطلاب)))
اطبع("الوسيط: " + نص(ح.وسيط(درجات_الطلاب)))
اطبع("المنوال (الأكثر تكراراً): " + نص(ح.منوال(درجات_الطلاب)))
اطبع("مدى البيانات (الفرق بين الأعلى والأدنى): " + نص(ح.مدى(درجات_الطلاب)))
اطبع("الانحراف المعياري: " + نص(ح.انحراف_معياري(درجات_الطلاب)))

اطبع("\n=== 3. معامل الارتباط الخطي (بيرسون) ===")
دع ساعات_الدراسة = [1، 2، 3، 4، 5]
دع درجات_الاختبار = [55، 65، 75، 85، 95]
دع معامل = ح.ارتباط(ساعات_الدراسة، درجات_الاختبار)
اطبع("معامل الارتباط بين ساعات الدراسة والدرجات: " + نص(معامل))
إذا (معامل == 1) {
    اطبع("ارتباط طردي تام (علاقة خطية قوية ومباشرة)")
}
