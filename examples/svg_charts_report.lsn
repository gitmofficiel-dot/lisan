# ============================================================================
# مثال توليد الرسوم البيانية العربية (RTL SVG) والتقارير التحليلية في لغة لسان
# تشغيل: lisan examples/svg_charts_report.lsn
# ============================================================================

استورد "ذكاء"

اطبع("=== جاري توليد الرسوم البيانية العربية المتجهة (RTL SVG) ===")

# 1. مخطط أعمدة عربي للمبيعات الفصلية
دع مخطط_مبيعات = جديد مخطط_أعمدة("المبيعات الفصلية حسب المنطقة (ألف ريال)"، 660، 360)
مخطط_مبيعات.أضف_بيان("الرياض"، 480، "#e65c1a")
مخطط_مبيعات.أضف_بيان("جدة"، 365، "#091d37")
مخطط_مبيعات.أضف_بيان("الدمام"، 290، "#0ea5e9")
مخطط_مبيعات.أضف_بيان("المدينة"، 230، "#10b981")
مخطط_مبيعات.أضف_بيان("أبها"، 185، "#8b5cf6")
دع svg_أعمدة = مخطط_مبيعات.بناء_svg()
مخطط_مبيعات.حفظ("تقرير_الأعمدة.svg")
اطبع("✅ تم توليد مخطط الأعمدة: تقرير_الأعمدة.svg (" + نص(طول(svg_أعمدة)) + " حرف)")

# 2. مخطط خطي لنمو مطوري لغة لسان
دع مخطط_نمو = جديد مخطط_خطي("نمو مجتمع مطوري لغة لسان خلال النصف الأول"، 660، 360، "#091d37")
مخطط_نمو.أضف_نقطة("يناير"، 1200)
مخطط_نمو.أضف_نقطة("فبراير"، 1850)
مخطط_نمو.أضف_نقطة("مارس"، 2600)
مخطط_نمو.أضف_نقطة("أبريل"، 3450)
مخطط_نمو.أضف_نقطة("مايو"، 4700)
مخطط_نمو.أضف_نقطة("يونيو"، 6200)
دع svg_خطي = مخطط_نمو.بناء_svg()
مخطط_نمو.حفظ("تقرير_النمو_الخطي.svg")
اطبع("✅ تم توليد المخطط الخطي: تقرير_النمو_الخطي.svg (" + نص(طول(svg_خطي)) + " حرف)")

# 3. مخطط دائري (دونات) لتوزيع استخدامات لغة لسان
دع مخطط_توزيع = جديد مخطط_دائري("توزيع مشاريع لغة لسان حسب المجال"، 520، 340)
مخطط_توزيع.أضف_شريحة("الذكاء الاصطناعي"، 38، "#e65c1a")
مخطط_توزيع.أضف_شريحة("تطبيقات الويب"، 28، "#091d37")
مخطط_توزيع.أضف_شريحة("إنترنت الأشياء"، 20، "#10b981")
مخطط_توزيع.أضف_شريحة("علوم البيانات"، 14، "#0ea5e9")
دع svg_دائري = مخطط_توزيع.بناء_svg()
مخطط_توزيع.حفظ("تقرير_الحصص_الدائري.svg")
اطبع("✅ تم توليد المخطط الدائري: تقرير_الحصص_الدائري.svg (" + نص(طول(svg_دائري)) + " حرف)")

# 4. لوحة رسم SVG حرة لبنية خط أنابيب الذكاء الاصطناعي
دع لوحة = جديد لوحة_رسم_svg(660، 220، "#f8fafc")
لوحة.مستطيل(16، 16، 628، 188، "#ffffff"، "#e2e8f0"، 1.5، 12)
لوحة.نص_svg(330، 46، "معمارية خط أنابيب علوم البيانات في لغة لسان"، 17، "#0f172a")
لوحة.مستطيل(460، 82، 150، 64، "#e65c1a"، "none"، 0، 10)
لوحة.نص_svg(535، 119، "1. جدول البيانات"، 14، "#ffffff")
لوحة.خط(460، 114، 405، 114، "#334155"، 2.5)
لوحة.مستطيل(255، 82، 150، 64، "#091d37"، "none"، 0، 10)
لوحة.نص_svg(330، 119، "2. نموذج التعلم"، 14، "#ffffff")
لوحة.خط(255، 114، 200، 114، "#334155"، 2.5)
لوحة.مستطيل(50، 82، 150، 64، "#10b981"، "none"، 0، 10)
لوحة.نص_svg(125، 119، "3. مخططات SVG"، 14، "#ffffff")
لوحة.دائرة(405، 114، 5، "#e65c1a")
لوحة.دائرة(200، 114، 5، "#10b981")
دع svg_لوحة = لوحة.بناء_svg()
لوحة.حفظ("لوحة_رسم_لسان.svg")
اطبع("✅ تم توليد لوحة الرسم المتجهة: لوحة_رسم_لسان.svg (" + نص(طول(svg_لوحة)) + " حرف)")

# 5. تجميع تقرير تحليلي HTML عربي RTL متكامل يحتوي على جميع المخططات
دع html = "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<title>التقرير التحليلي للغة لسان</title>\n<style>body{font-family:Cairo,Tahoma,Arial,sans-serif;background:#f1f5f9;color:#0f172a;margin:0;padding:32px;}h1{text-align:center;color:#091d37;margin-bottom:28px;}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(520px,1fr));gap:24px;max-width:1360px;margin:0 auto;}.card{background:#fff;border-radius:14px;padding:16px;box-shadow:0 4px 16px rgba(15,23,42,0.06);display:flex;justify-content:center;align-items:center;}svg{max-width:100%;height:auto;}</style>\n</head>\n<body>\n<h1>لوحة التقارير والرسوم البيانية — لغة لسان العربية</h1>\n<div class=\"grid\">\n<div class=\"card\">" + svg_أعمدة + "</div>\n<div class=\"card\">" + svg_خطي + "</div>\n<div class=\"card\">" + svg_دائري + "</div>\n<div class=\"card\">" + svg_لوحة + "</div>\n</div>\n</body>\n</html>"
اكتب_ملف("تقرير_بيانات_لسان.html"، html)

اطبع("📊 تم تصدير لوحة التقارير التفاعلية الكاملة إلى: تقرير_بيانات_لسان.html")
