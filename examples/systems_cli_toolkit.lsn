# مثال شامل لأدوات الأنظمة وسطر الأوامر والملفات والبصمات والضغط وتنفيذ أوامر النظام
# تشغيل: lisan examples/systems_cli_toolkit.lsn

استورد "أنظمة"

# 1. أدوات واجهة سطر الأوامر (CLI Toolkit)
دع أداة = جديد أداة_سطر_أوامر("حزمة أنظمة لسان"، "1.0.0")
اطبع(أداة.إطار_عنوان("لوحة أتمتة الأنظمة وسطر الأوامر"))
اطبع(أداة.ملوّن("✓ بدء فحص بيئة الأنظمة والأدوات القياسية"، "أخضر"))
اطبع(أداة.ملوّن("ℹ جميع الأدوات تعمل بلغة Rust القياسية دون تبعيات خارجية"، "سماوي"))

# عرض شريط التقدم النصي
اطبع("تقدم تهيئة الخدمات:")
اطبع("  25%:  " + أداة.شريط_تقدم_نصي(25، 24))
اطبع("  65%:  " + أداة.شريط_تقدم_نصي(65، 24))
اطبع("  100%: " + أداة.شريط_تقدم_نصي(100، 24))

# 2. السجل المهيكَل للأحداث (Structured Logger)
دع مسجل = جديد سجل_أحداث("محرك_الأنظمة")
مسجل.معلومات("تم تهيئة وحدة المسارات ونظام الملفات")
مسجل.تحذير("سيتم إنشاء مجلد مؤقت لتجربة النسخ والنقل ثم حذفه")
مسجل.عطل("محاكاة تنبيه عطل شبكي للتوثيق فقط")
اطبع("إجمالي الأحداث المسجلة: " + نص(مسجل.عدد_السجلات()))

# 3. مجدول المهام وسير العمل (Task Pipeline)
دع مجدول = جديد مجدول_مهام("سير_عمل_الأتمتة")
مجدول.أضف_مهمة("حساب بصمات التحقق CRC-32"، 2)
مجدول.أضف_مهمة("تهيئة بيئة العمل المؤقتة"، 5)
مجدول.أضف_مهمة("ضغط البيانات عبر RLE"، 3)
مجدول.أضف_مهمة("تنظيف الملفات المؤقتة"، 1)
مجدول.نفّذ_الكل()
اطبع(مجدول.تقرير())

# 4. عمليات المسارات (Path Operations)
دع مجلد_تجربة = "مجلد_اختبار_أنظمة_لسان"
دع مسار_أصلي = مسار_ادمج([مجلد_تجربة، "بيانات.txt"])
دع مسار_نسخة = مسار_ادمج([مجلد_تجربة، "نسخة.txt"])
دع مسار_منقول = مسار_ادمج([مجلد_تجربة، "أرشيف_نهائي.txt"])

اطبع(أداة.جدول_طرفية(
    ["العملية"، "المخرجات"]،
    [
        ["المسار المدمج"، مسار_أصلي]،
        ["اسم الملف"، اسم_ملف(مسار_أصلي)]،
        ["الامتداد"، امتداد_ملف(مسار_أصلي)]،
        ["المجلد الأب"، مجلد_أب(مسار_أصلي)]
    ]
))

# 5. عمليات الملفات والمجلدات (نسخ، حجم، نقل، حذف مجلد)
أنشئ_مجلد(مجلد_تجربة)
دع نص_ملف = "بيانات اختبار حزمة الأنظمة في لغة لسان العربية — 2026"
اكتب_ملف(مسار_أصلي، نص_ملف)
دع حجم_أصلي = حجم_ملف(مسار_أصلي)
دع بايت_منسوخ = انسخ_ملف(مسار_أصلي، مسار_نسخة)
انقل_ملف(مسار_نسخة، مسار_منقول)
اطبع("حجم الملف الأصلي: " + نص(حجم_أصلي) + " بايت | تم نسخ: " + نص(بايت_منسوخ) + " بايت")
احذف_مجلد(مجلد_تجربة)
اطبع(أداة.ملوّن("✓ تم تنظيف المجلد المؤقت بنجاح"، "أخضر"))

# 6. بصمة IEEE 802.3 CRC-32 وضغط RLE غير الفاقد
دع بصمة_قياسية = بصمة_crc32("123456789")
دع نص_متكرر = "أأأأأأأأأأأأأأأأأأأأ — LLLLLLLLLLLLLLL — لغة لسان 2026!"
دع مضغوط = ضغط_rle(نص_متكرر)
دع مفكوك = فك_ضغط_rle(مضغوط)
دع تطابق_ضغط = "نعم"
إذا (مفكوك != نص_متكرر) {
    تطابق_ضغط = "لا"
}

اطبع(أداة.جدول_طرفية(
    ["الاختبار"، "النتيجة"]،
    [
        ["CRC-32 لـ 123456789"، بصمة_قياسية]،
        ["الطول قبل ضغط RLE"، نص(طول(نص_متكرر)) + " محرف"]،
        ["الطول بعد ضغط RLE"، نص(طول(مضغوط)) + " محرف"]،
        ["النص المضغوط"، مضغوط]،
        ["تطابق الاسترجاع 100%"، تطابق_ضغط]
    ]
))

# 7. تنفيذ أمر نظام التشغيل
حاول {
    دع نتيجة_أمر = نفّذ_أمر("echo"، ["مرحباً من نظام التشغيل عبر لغة لسان!"])
    اطبع("نجاح أمر النظام: " + نص(نتيجة_أمر["نجاح"]) + " | كود الخروج: " + نص(نتيجة_أمر["كود"]))
    اطبع("مخرج الأمر: " + نظّف(نتيجة_أمر["مخرج"]))
} التقط (عطل_أمر) {
    اطبع(أداة.ملوّن("تنبيه تنفيذ الأمر: " + نص(عطل_أمر)، "أصفر"))
}

# 8. تصدير السجل المهيكَل إلى JSON
اطبع("سجل الأحداث بصيغة JSON:")
اطبع(مسجل.تصدير_json())
