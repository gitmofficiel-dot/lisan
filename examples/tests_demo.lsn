# مثال على حزمة اختبارات لسان المدمجة
# يمكن تشغيلها عبر: lisan اختبار examples/tests_demo.lsn

دالة جمع(أ، ب) {
    أرجع أ + ب
}

دالة ضرب(أ، ب) {
    أرجع أ * ب
}

دالة نص_ترحيب(اسم) {
    أرجع "مرحباً يا " + اسم
}

دالة اختبار_العمليات_الحسابية() {
    تحقق_يساوي(جمع(15، 25)، 40)
    تحقق_يساوي(ضرب(6، 7)، 42)
}

دالة اختبار_النصوص() {
    تحقق_يساوي(نص_ترحيب("زيد")، "مرحباً يا زيد")
    تحقق_صحيح(طول(نص_ترحيب("علي")) > 0)
}

دالة اختبار_القوائم_والتضمين() {
    دع أرقام = [1، 2، 3، 4]
    تحقق_يساوي(طول(أرقام)، 4)
    تحقق_يساوي(أرقام.مجموع()، 10)
    تحقق(3 في أرقام)
}
