# مثال على مكتبة معالجة النصوص والترميز في لسان
# تشغيل: lisan examples/text_encoding.lsn

استورد نصوص كـ ن

دع نص_أصلي = "لسان: لغة برمجة عربية عصرية فائقة السرعة"
اطبع("النص الأصلي: " + نص_أصلي)

# 1. ترميز وفك قاعدة 64 (Base64)
دع مشفر = ن.ترميز_قاعدة64(نص_أصلي)
اطبع("مشفر بـ Base64: " + مشفر)

دع مفكوك = ن.فك_قاعدة64(مشفر)
اطبع("مفكوك من Base64: " + مفكوك)
تحقق_يساوي(مفكوك، نص_أصلي)

# 2. ترميز وفك روابط الويب (URL Encoding)
دع رابط = "https://lisan-lang.org/بحث?كلمة=الذكاء الاصطناعي&صفحة=1"
دع رابط_مرمز = ن.ترميز_url(رابط)
اطبع("الرابط المرمز: " + رابط_مرمز)

دع رابط_مفكوك = ن.فك_url(رابط_مرمز)
اطبع("الرابط المفكوك: " + رابط_مفكوك)
تحقق_يساوي(رابط_مفكوك، رابط)

# 3. محاذاة وحشو النصوص (Padding)
دع رقم_تعريفي = "42"
دع ممتلئ_يسار = ن.حشو_يسار(رقم_تعريفي، 8، "0")
اطبع("رقم معبأ لليسار بأصفار: " + ممتلئ_يسار)

دع عنوان = "فهرس"
دع ممتلئ_يمين = ن.حشو_يمين(عنوان، 15، ".")
اطبع("عنوان محشو بنقاط لليمين: " + ممتلئ_يمين)

اطبع("اكتملت جميع عمليات النصوص والترميز بنجاح!")
