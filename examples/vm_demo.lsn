// تجربة آلة بايت كود لسان الافتراضية السريعة (Lisan Bytecode VM)

دع درجات_الطلاب = {
    "أحمد": 95,
    "سارة": 88,
    "محمود": 72
}

اطبع("الطلاب المسجلون: " + مفاتيح(درجات_الطلاب))
اطبع("الدرجات المسجلة: " + قيم(درجات_الطلاب))

ليكن درجات = قيم(درجات_الطلاب)
اطبع("المجموع عبر VM: " + مجموع(درجات))
اطبع("المتوسط عبر VM: " + متوسط(درجات))
اطبع("أعلى درجة: " + أعلى(درجات[0], درجات[1]))

لكل (اسم في مفاتيح(درجات_الطلاب)) {
    ليكن ن = درجات_الطلاب[اسم]
    إذا (ن >= 90) {
        اطبع(اسم + ": متفوق")
    } وإلا {
        اطبع(اسم + ": مجتهد")
    }
}
