# مثال تطبيق ويب متكامل (Full-Stack) بلغة لسان 2.0
# يجمع بين إطار عمل الويب (تطبيق_ويب، قالب_صفحة) ومولّد المواقع (موقع_ويب)
# تشغيل: lisan --interpret examples/web_fullstack_app.lsn

استورد "موقع"
استورد "إطار_ويب"

اطبع("=== إطلاق منصة لسان السحابية — تطبيق ويب متكامل 2.0 ===")

# 1. بناء الصفحة الرئيسية باستخدام موقع_ويب ومكونات 2.0 الحديثة
دع بوابة = جديد موقع_ويب("منصة لسان السحابية"، "لسان")
بوابة.أضف_تنبيه_أعلى("الإصدار 2.0 من إطار عمل الويب بلغة لسان متاح الآن بدون أي تبعيات خارجية!"، "نجاح")
بوابة.شريط_تنقل("منصة لسان السحابية"، "صاروخ")
بوابة.قسم_رئيسي(
    "ابنِ تطبيقات ويب عربية كاملة بسرعة الصاروخ"،
    "توجيه مسارات HTTP/1.1، محرك قوالب آمن ضد XSS، ومكونات واجهة متجاوبة بالكامل بالعربية الفصيحة."،
    "استكشف المنصة"،
    "صاروخ"
)
بوابة.أضف_إحصائيات([
    ["أيقونات SVG مدمجة"، "+68"، "جائزة"]،
    ["التبعيات الخارجية"، "0"، "درع"]،
    ["توافق المتصفح والخادم"، "Native + WASM"، "شريحة"]،
    ["أمان القوالب"، "XSS Safe"، "قفل"]
])
بوابة.أضف_شبكة([
    ["توجيه مسارات ذكي"، "دعم GET و POST و JSON و HTML مع اكتشاف تلقائي لنوع المحتوى وترويسات CORS."، "رابط"]،
    ["محرك قوالب آمن"، "يدعم المسارات المتداخلة {{مستخدم.اسم}} والتهريب التلقائي للوقاية من حقن الشيفرات."، "مستند"]،
    ["تصميم عربي أصيل"، "دعم كامل لاتجاه RTL وأنساق لونية متعددة مع تبديل فوري بين الوضع الليلي والنهاري."، "مصباح"]
])
بوابة.أضف_معرض([
    ["بوابة التجارة الذكية"، "متجر عربي متكامل بواجهات سريعة وتصدير PWA."، "تجارة إلكترونية"، "متجر"]،
    ["لوحة مراقبة IoT"، "ربط مباشر مع ESP32 وأردوينو مع قراءات لحظية."، "إنترنت الأشياء"، "أردوينو"]،
    ["نظام العيادات الرقمي"، "إدارة مواعيد وملفات مرضى بأمان عالٍ."، "رعاية صحية"، "قلب_نبض"]
])
بوابة.أضف_جدول(
    ["المسار"، "الطريقة"، "نوع الاستجابة"، "الوصف"]،
    [
        ["/"، "GET"، "text/html"، "الصفحة الرئيسية الكاملة للمنصة"]،
        ["/لوحة"، "GET"، "text/html"، "لوحة المستخدم المصيّرة عبر محرك القوالب"]،
        ["/api/health"، "GET"، "application/json"، "فحص جاهزية الخادم"]،
        ["/api/courses"، "GET"، "application/json"، "قائمة الدورات البرمجية"]،
        ["/api/subscribe"، "POST"، "application/json"، "تسجيل اشتراك جديد"]
    ]
)
بوابة.أضف_أسعار([
    ["باقة البداية"، "مجاناً"، "مثالية للتعلم والمشاريع المفتوحة"، ["مفسّر لسان الكامل"، "قوالب HTML الآمنة"، "تصدير مواقع ثابتة"]، خطأ، "ابدأ مجاناً"]،
    ["باقة المحترفين"، "49 ر.س / شهر"، "للفرق وتطبيقات الويب والهاتف الشاملة"، ["إطار الويب 2.0 الكامل"، "تصدير تطبيقات PWA دون اتصال"، "دعم تقني مباشر"]، صحيح، "اختر الاحترافية"]
])
بوابة.أضف_شهادات([
    ["د. سارة المنصور"، "مهندسة برمجيات"، "بناء موقع كامل وواجهة API بالعربية الصافية اختصر علينا نصف وقت التطوير!"، "★★★★★"]،
    ["طارق الحربي"، "مطور نظم مدمجة"، "أفضل ما في لسان هو انعدام التبعيات الخارجية مع جودة عالية في التصميم والأمان."، "★★★★★"]
])
بوابة.أضف_أسئلة_شائعة([
    ["هل يدعم إطار عمل الويب تشغيل خادم HTTP حقيقي؟"، "نعم، عبر الدالة تطبيق.شغّل() يتم تشغيل خادم HTTP/1.1 قياسي متعدد المسارات مع ترويسات CORS وصفحة 404 عربية."]،
    ["كيف يحمي محرك القوالب من ثغرات XSS؟"، "يتم تهريب جميع قيم {{مفتاح}} تلقائياً، بينما تُستخدم {{{مفتاح}}} فقط عند الرغبة الصريحة في إدراج HTML موثوق."]
])
بوابة.أضف_نموذج_تواصل("تواصل مع فريق المنصة"، "نرحب بجميع استفساراتكم ومقترحاتكم التقنية"، "إرسال")
بوابة.أضف_تذييل("جميع الحقوق محفوظة © منصة لسان السحابية 2026")

دع صفحة_الرئيسية = بوابة.بناء_html()

# 2. تصيير صفحة لوحة المستخدم عبر محرك القوالب الآمن (قالب_صفحة)
دع قالب_اللوحة = جديد قالب_صفحة(
    "<!DOCTYPE html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"UTF-8\"><title>لوحة {{مستخدم.اسم}}</title></head><body><h1>أهلاً بك يا {{مستخدم.اسم}}</h1><p>خطتك الحالية: {{مستخدم.خطة}}</p><div>{{{شارة_html}}}</div><p>أحدث دورة: {{دورات.0}}</p></body></html>"
)

دع صفحة_اللوحة = قالب_اللوحة.عرض({
    "مستخدم": {
        "اسم": "عمر <مطور>"،
        "خطة": "باقة المحترفين"
    }،
    "شارة_html": "<span class=\"badge\">عضو موثّق</span>"،
    "دورات": ["تطوير الويب بلغة لسان 2.0"، "برمجة المتحكمات الذكية"]
})

# التحقق من أمان محرك القوالب (تهريب {{}} والسماح لـ {{{}}})
تحقق(يحتوي(صفحة_اللوحة، "عمر &lt;مطور&gt;"))
تحقق(ليس يحتوي(صفحة_اللوحة، "عمر <مطور>"))
تحقق(يحتوي(صفحة_اللوحة، "<span class=\"badge\">عضو موثّق</span>"))
تحقق(يحتوي(صفحة_اللوحة، "تطوير الويب بلغة لسان 2.0"))

# 3. إنشاء تطبيق الويب وتسجيل المسارات (HTML + JSON + POST)
دع تطبيق = جديد تطبيق_ويب("منصة لسان السحابية"، 8080)
تطبيق.رد_html("/"، صفحة_الرئيسية)
تطبيق.رد_html("/لوحة"، صفحة_اللوحة)
تطبيق.رد_json("/api/health"، {
    "خادم": "لسان ويب 2.0"،
    "جاهز": صحيح،
    "عدد_المسارات": 5
})
تطبيق.رد_json("/api/courses"، {
    "إجمالي": 2،
    "عناصر": [
        {"معرف": 1، "عنوان": "أساسيات إطار الويب العربي"}،
        {"معرف": 2، "عنوان": "بناء تطبيقات PWA دون اتصال"}
    ]
})
تطبيق.مسار_post("/api/subscribe"، "{\"نجاح\": true, \"رسالة\": \"تم تسجيل اشتراكك بنجاح\"}")

# 4. محاكاة الطلبات والتحقق من التوجيه والاستجابات دون حجب التنفيذ
دع رد_رئيسية = تطبيق.محاكاة_طلب("GET"، "/")
تحقق(رد_رئيسية["نجاح"])
تحقق(رد_رئيسية["حالة"] == 200)
تحقق(يحتوي(رد_رئيسية["نوع_المحتوى"]، "text/html"))
تحقق(يحتوي(رد_رئيسية["جسم"]، "web-pricing"))
تحقق(يحتوي(رد_رئيسية["جسم"]، "web-faq-item"))
تحقق(يحتوي(رد_رئيسية["جسم"]، "web-table"))
تحقق(يحتوي(رد_رئيسية["جسم"]، "web-testimonials"))
تحقق(يحتوي(رد_رئيسية["جسم"]، "web-gallery"))

دع رد_لوحة = تطبيق.محاكاة_طلب("GET"، "/لوحة?tab=overview&lang=ar")
تحقق(رد_لوحة["حالة"] == 200)
تحقق(رد_لوحة["استعلام"]["tab"] == "overview")
تحقق(رد_لوحة["استعلام"]["lang"] == "ar")

دع رد_api = تطبيق.محاكاة_طلب("GET"، "/api/health")
تحقق(رد_api["حالة"] == 200)
تحقق(يحتوي(رد_api["نوع_المحتوى"]، "application/json"))
تحقق(يحتوي(رد_api["استجابة_http"]، "HTTP/1.1 200 OK"))

دع رد_post = تطبيق.محاكاة_طلب("POST"، "/api/subscribe")
تحقق(رد_post["حالة"] == 200)
تحقق(يحتوي(رد_post["جسم"]، "تم تسجيل اشتراكك بنجاح"))

دع رد_مفقود = تطبيق.محاكاة_طلب("GET"، "/مسار_غير_موجود")
تحقق(ليس رد_مفقود["نجاح"])
تحقق(رد_مفقود["حالة"] == 404)
تحقق(يحتوي(رد_مفقود["جسم"]، "الصفحة غير موجودة"))

اطبع("عدد المسارات المسجلة: " + نص(تطبيق.عدد_المسارات()))
اطبع("حجم الصفحة الرئيسية المولدة (حرف): " + نص(طول(صفحة_الرئيسية)))
اطبع("اختبار GET / -> " + نص(رد_رئيسية["حالة"]) + " (" + رد_رئيسية["نوع_المحتوى"] + ")")
اطبع("اختبار GET /لوحة?tab=overview -> " + نص(رد_لوحة["حالة"]) + " | التبويب: " + رد_لوحة["استعلام"]["tab"])
اطبع("اختبار GET /api/health -> " + نص(رد_api["حالة"]) + " (" + رد_api["نوع_المحتوى"] + ")")
اطبع("اختبار POST /api/subscribe -> " + نص(رد_post["حالة"]))
اطبع("اختبار GET /مسار_غير_موجود -> " + نص(رد_مفقود["حالة"]))
اطبع("تم التحقق من تطبيق الويب المتكامل بنجاح! (لتشغيل الخادم الحي استدعِ: تطبيق.شغّل(0))")
