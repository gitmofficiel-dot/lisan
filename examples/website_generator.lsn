# مثال بناء وتوليد موقع ويب متكامل باللغة العربية عبر لسان
# تشغيل: lisan examples/website_generator.lsn

استورد "موقع"

اطبع("=== جاري بناء موقع ويب متكامل باللغة العربية ===")

# 1. إنشاء كائن الموقع واختيار النسق اللوني ("ملكي" / "زمردي" / "محيطي" / "غروب" / "فاتح")
دع موقعي = جديد موقع_ويب("بوابة لسان العربية", "ملكي")

# 2. شريط التنقل العلوي مع روابط سريعة وزر تبديل النسق
موقعي.شريط_تنقل("بوابة لسان العربية", "كود")

# 3. القسم الترحيبي الرئيسي (Hero Banner)
موقعي.قسم_رئيسي(
    "أهلاً بكم في بوابة لسان",
    "أول موقع ويب متكامل يتم بناؤه وتوليده وتنسيقه بالكامل بلغة البرمجة العربية الفصيحة لسان 1.0.0",
    "ابدأ الاستكشاف",
    "روبوت"
)

# 4. إحصائيات سريعة بالأرقام
موقعي.أضف_إحصائيات([
    ["السرعة والكفاءة", "100%", "شريحة"],
    ["الأمان الرقمي", "0 تبعيات", "درع"],
    ["دعم المتحكمات", "Arduino / ESP32 / STM32", "أردوينو"],
    ["الواجهات والتطبيقات", "Web & PWA", "هاتف"]
])

# 5. شبكة الميزات والخدمات
موقعي.أضف_شبكة([
    ["محرك عالي الأداء", "تجمع لسان بين سهولة بايثون وقوة لغة Rust مع إمكانية الترجمة إلى كود آلة أصلي عبر Clang و LLVM.", "شريحة"],
    ["تصميم متجاوب بالكامل", "صفحات ويب حديثة وتطبيقات هواتف ذكية متناسقة تلقائياً بدون أي ملفات خارجية.", "هاتف"],
    ["إنترنت الأشياء والمتحكمات", "مكتبات برمجية كاملة لدعم Arduino AVR و ESP32 و STM32 مع محاكاة فورية وترجمة إلى C++.", "أردوينو"],
    ["حماية وأمان كامل", "تشفير قياسي وتوليد ذاتي للأيقونات والأنماط بدون الحاجة لتحميل أي حزم من الإنترنت.", "درع"]
])

# 6. قسم تعريفي عن المشروع
موقعي.أضف_قسم(
    "عن لغة لسان",
    "لغة لسان هي لغة برمجة عربية فصيحة عصرية صُممت لتكون أداة شاملة للتعليم والتطوير وهندسة النظم وإنترنت الأشياء والويب والذكاء الاصطناعي، بهوية عربية أصيلة وأداء هندسي عالمي.",
    "معلومات"
)

# 7. نموذج تواصل تفاعلي
موقعي.أضف_نموذج_تواصل(
    "تواصل مع فريق لسان",
    "يسعدنا استقبال آرائكم واقتراحاتكم لتطوير منظومة لسان ومكتباتها القياسية",
    "إرسال الرسالة"
)

# 8. تذييل الصفحة
موقعي.أضف_تذييل("جميع الحقوق محفوظة © 2026 — صُنع بكل فخر بواسطة لغة لسان العربية الفصيحة")

# 9. توليد وتصدير ملفات الموقع
دع مسار_الموقع = موقعي.تصدير("موقع")
موقعي.حفظ("موقع_لسان.html")

اطبع("✅ تم بناء وتوليد الموقع بنجاح!")
اطبع("📁 مسار المجلد: موقع/index.html")
اطبع("📄 مسار الملف المباشر: موقع_لسان.html")
اطبع("🌐 يمكنك فتح الملف مباشرة في أي متصفح ويب، أو تشغيل خادم محلي لتصفحه!")
