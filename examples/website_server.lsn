# خادم محلي لاستضافة وعرض الموقع العربي المبني بلغة لسان
# تشغيل: lisan --interpret examples/website_server.lsn

استورد "موقع"
استورد شبكة كـ ش

اطبع("=== جاري تجهيز الموقع وتشغيل الخادم المحلي ===")

دع موقعي = جديد موقع_ويب("بوابة لسان العربية", "زمردي")
موقعي.شريط_تنقل("بوابة لسان العربية", "كود")
موقعي.قسم_رئيسي(
    "أهلاً بكم في بوابة لسان",
    "موقع ويب عربي متكامل خفيف وسريع، تم توليده واستضافته مباشرة بنواة لسان 1.0.0",
    "استكشف الميزات",
    "شمس"
)
موقعي.أضف_إحصائيات([
    ["السرعة والكفاءة", "100%", "شريحة"],
    ["الأمان الرقمي", "0 تبعيات", "درع"],
    ["دعم المتحكمات", "Arduino / ESP32 / STM32", "أردوينو"],
    ["الواجهات والتطبيقات", "Web & PWA", "هاتف"]
])
موقعي.أضف_شبكة([
    ["محرك عالي الأداء", "تجمع لسان بين سهولة بايثون وقوة لغة Rust مع إمكانية الترجمة إلى كود آلة أصلي.", "شريحة"],
    ["تصميم متجاوب بالكامل", "صفحات ويب حديثة وتطبيقات هواتف ذكية متناسقة تلقائياً بدون أي ملفات خارجية.", "هاتف"],
    ["إنترنت الأشياء والمتحكمات", "مكتبات برمجية كاملة لدعم Arduino و ESP32 و STM32.", "أردوينو"],
    ["حماية وأمان كامل", "تشفير قياسي وتوليد ذاتي للأيقونات والأنماط بدون تحميل حزم خارجية.", "درع"]
])
موقعي.أضف_قسم(
    "عن لغة لسان",
    "لغة لسان هي لغة برمجة عربية فصيحة عصرية بهوية عربية وأداء هندسي عالمي.",
    "معلومات"
)
موقعي.أضف_نموذج_تواصل(
    "تواصل معنا",
    "أرسل لنا استفسارك أو اقتراحاتك لتطوير المنظومة",
    "إرسال الرسالة"
)
موقعي.أضف_تذييل("جميع الحقوق محفوظة © 2026 — صُنع بكل فخر بواسطة لغة لسان العربية الفصيحة")

دع كود_الموقع = موقعي.بناء_html()
موقعي.حفظ("موقع_لسان.html")

اطبع("🚀 تم تجهيز ملفات الموقع بنجاح!")
اطبع("📄 مسار الملف: موقع_لسان.html")
اطبع("🌐 لتشغيل الخادم المحلي: ش.خادم_ويب(8088، {\"/\": كود_الموقع})")
