{
  "name": "lisan-studio-experience",
  "displayName": "استوديو لسان — الحسابات والواجهة والسمات (Lisan Studio Experience)",
  "description": "نظام حسابات المستخدمين، الشريط الجانبي العربي، محوّل بايثون إلى لسان، والسمات الرسمية لمحرر استوديو لسان",
  "version": "1.2.0",
  "publisher": "lisan-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onAuthenticationRequest:lisan-account",
    "onView:lisanStudio.accountView",
    "onView:lisanStudio.toolsView"
  ],
  "main": "./extension.js",
  "contributes": {
    "themes": [
      {
        "label": "ليلي لسان (Lisan Midnight)",
        "uiTheme": "vs-dark",
        "path": "./themes/lisan-midnight-color-theme.json"
      },
      {
        "label": "نهاري لسان (Lisan Daylight)",
        "uiTheme": "vs",
        "path": "./themes/lisan-daylight-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lisanStudio",
          "title": "استوديو لسان",
          "icon": "media/lisan-activity.svg"
        }
      ]
    },
    "views": {
      "lisanStudio": [
        {
          "type": "webview",
          "id": "lisanStudio.accountView",
          "name": "حسابي في لسان"
        },
        {
          "type": "webview",
          "id": "lisanStudio.toolsView",
          "name": "أدوات لسان ومحوّل بايثون"
        }
      ]
    },
    "authentication": [
      {
        "id": "lisan-account",
        "label": "حساب لسان (Lisan Account)"
      }
    ],
    "commands": [
      {
        "command": "lisanStudio.openWelcome",
        "title": "استوديو لسان: لوحة الترحيب الرئيسية",
        "icon": "$(home)"
      },
      {
        "command": "lisanStudio.signUp",
        "title": "استوديو لسان: إنشاء حساب جديد"
      },
      {
        "command": "lisanStudio.signIn",
        "title": "استوديو لسان: تسجيل الدخول إلى حساب لسان"
      },
      {
        "command": "lisanStudio.signOut",
        "title": "استوديو لسان: تسجيل الخروج من حساب لسان"
      },
      {
        "command": "lisanStudio.copyMcpConfig",
        "title": "استوديو لسان: نسخ إعداد خادم وكلاء الذكاء (MCP)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "استوديو لسان (Lisan Studio)",
      "properties": {
        "lisanStudio.accountServerUrl": {
          "type": "string",
          "default": "",
          "description": "رابط خادم حسابات سحابي اختياري لمزامنة حسابات لسان (اتركه فارغاً للحسابات المحلية المشفّرة)"
        }
      }
    }
  }
}
