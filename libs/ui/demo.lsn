# عرض مكتبة lisan-ui 2.0: يولّد demo.html
# التشغيل من جذر المستودع:  lisan --interpret libs/ui/demo.lsn
استورد "lisan_ui.lsn"

دع شريط = واجهة_شريط_علوي("لسان 2.0"، [
    ["الميزات"، "#features"]،
    ["الجدول"، "#table"]،
    ["الباقات"، "#pricing"]،
    ["الأسئلة"، "#faq"]
])

دع تنبيه = واجهة_تنبيه("إصدار lisan-ui 2.0 متاح الآن!"، "مكونات RTL جديدة آمنة ضد XSS ومتوافقة مع معايير الإتاحة WCAG."، "نجاح")

دع بطل = واجهة_بطل("لسان"، "لغة برمجة عربية فصيحة بمعمارية حديثة ونظام تصميم متكامل"، [
    واجهة_زر("ابدأ التثبيت"، "#install")،
    واجهة_زر_شفاف("الوثائق"، "#docs")
])

دع إحصاءات = واجهة_شبكة([
    واجهة_إحصائية(83، "وحدة عتاد")،
    واجهة_إحصائية(68، "أيقونة متجهة")،
    واجهة_إحصائية(3، "طرق تنفيذ")
])

دع بطاقات = واجهة_شبكة([
    واجهة_بطاقة("عربية أولاً"، "الكلمات المفتاحية والرسائل والمكونات بالعربية الفصيحة")،
    واجهة_بطاقة("سريعة"، "مفسّر وآلة افتراضية وتصريف أصلي عبر LLVM")،
    واجهة_بطاقة("آمنة ومفتوحة"، "حماية مدمجة من XSS وترخيص MIT")
])

دع جدول = واجهة_جدول(
    ["المكوّن"، "الوظيفة"، "الأمان"],
    [
        ["واجهة_شريط_علوي"، "تنقل علوي ثابت"، "فحص الروابط وتهريب HTML"]،
        ["واجهة_جدول"، "عرض بيانات متجاوب"، "تهريب جميع الخلايا"]،
        ["واجهة_باقة"، "عرض خطط الأسعار"، "تحقق تلقائي من روابط الأزرار"]
    ]
)

دع باقات = واجهة_شبكة([
    واجهة_باقة("المجانية"، "0$"، "للمتعلمين والمشاريع الفردية"، ["المفسّر الكامل"، "مكتبة lisan-ui"، "أمثلة تعليمية"]، "ابدأ مجاناً"، "#start")،
    واجهة_باقة("الاحترافية"، "29$/شهر"، "للفرق وتطبيقات الويب والهاتف"، ["إطار الويب 2.0"، "تصدير PWA كامل"، "دعم أولوية"]، "اشترك الآن"، "#pro")
])

دع تقدم = واجهة_شريط_تقدم("تغطية مكونات نظام التصميم 2.0"، 95)

دع أسئلة = واجهة_سؤال("هل مكتبة lisan-ui تحتاج إلى اعتماديات خارجية؟"، "لا، جميع المكونات مكتوبة بالكامل بلغة لسان الصافية دون أي ملفات خارجية.")

دع كود = واجهة_كود("دع الاسم = \"العالم\"\nاطبع(\"مرحبا يا \" + الاسم)")

دع تذييل = واجهة_تذييل("جميع الحقوق محفوظة © مشروع لغة لسان 2026"، [
    ["التوثيق"، "/docs/"]،
    ["الأمثلة"، "#features"]،
    ["راسلنا"، "mailto:hello@lisan.dev"]
])

اكتب_ملف("libs/ui/demo.html"، واجهة_صفحة("عرض lisan-ui 2.0"، [
    شريط، تنبيه، بطل، إحصاءات، بطاقات، جدول، باقات، تقدم، أسئلة، واجهة_شارة("v2.0")، كود، تذييل
]))
اطبع("تم توليد libs/ui/demo.html")
