# عرض مكتبة lisan-ui: يولّد demo.html
# التشغيل من جذر المستودع:  lisan --interpret libs/ui/demo.lsn
استورد "lisan_ui.lsn"

دع بطل = واجهة_بطل("لسان"، "لغة برمجة عربية فصيحة بمعمارية حديثة"، [واجهة_زر("ابدأ التثبيت"، "#install")، واجهة_زر_شفاف("الوثائق"، "#docs")])
دع إحصاءات = واجهة_شبكة([واجهة_إحصائية(83، "وحدة عتاد")، واجهة_إحصائية(3، "طرق تنفيذ")، واجهة_إحصائية(3، "أنظمة أرقام")])
دع بطاقات = واجهة_شبكة([واجهة_بطاقة("عربية أولاً"، "الكلمات المفتاحية والرسائل بالعربية")، واجهة_بطاقة("سريعة"، "مفسّر وآلة افتراضية وتصريف أصلي")، واجهة_بطاقة("مفتوحة"، "رخصة MIT")])
دع كود = واجهة_كود("دع الاسم = \"العالم\"\nاطبع(\"مرحبا يا \" + الاسم)")
اكتب_ملف("libs/ui/demo.html"، واجهة_صفحة("عرض lisan-ui"، [بطل، إحصاءات، بطاقات، واجهة_شارة("v1.0")، كود]))
اطبع("تم توليد libs/ui/demo.html")
