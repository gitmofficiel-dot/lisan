# اختبار أمان lisan-ui 2.0: يجب ألا يظهر أي نص حي خطير أو رابط javascript:
استورد "lisan_ui.lsn"

# 1. اختبارات المكونات الأساسية (التوافق الرجعي الكامل)
دع ب = واجهة_زر("x\" onclick=\"alert(1)"، "javascript:alert(1)")
اطبع(ب)
اطبع(واجهة_زر("موقع"، "https://example.com/?a=1&b=2"))
اطبع(واجهة_إحصائية("<img src=x onerror=alert(1)>"، "وصف"))
اطبع(واجهة_زر("آمن"، "/docs/"))
تحقق(ليس يحتوي(ب، "javascript:"))
تحقق(ليس يحتوي(ب، "\" onclick"))

# 2. اختبار الشريط العلوي: رفض javascript: وتهريب HTML
دع شريط_خطر = واجهة_شريط_علوي("<script>evil()</script>"، [
    ["رابط <b>خبيث</b>"، "javascript:alert(99)"]،
    ["توثيق آمن"، "/docs/guide"]
])
تحقق(ليس يحتوي(شريط_خطر، "<script>"))
تحقق(ليس يحتوي(شريط_خطر، "javascript:"))
تحقق(يحتوي(شريط_خطر، "&lt;script&gt;"))
تحقق(يحتوي(شريط_خطر، "href=\"/docs/guide\""))

# 3. اختبار التنبيه: تهريب العنوان والرسالة
دع تنبيه_خطر = واجهة_تنبيه("<img src=x onerror=alert(1)>"، "رسالة <script>x</script>"، "خطر")
تحقق(ليس يحتوي(تنبيه_خطر، "<img"))
تحقق(ليس يحتوي(تنبيه_خطر، "<script>"))
تحقق(يحتوي(تنبيه_خطر، "role=\"alert\""))

# 4. اختبار الجدول: تهريب جميع الترويسات والخلايا
دع جدول_خطر = واجهة_جدول(
    ["عمود <script>1</script>"]،
    [["<svg onload=alert(1)>"]]
)
تحقق(ليس يحتوي(جدول_خطر، "<script>"))
تحقق(ليس يحتوي(جدول_خطر، "<svg"))
تحقق(يحتوي(جدول_خطر، "&lt;svg onload=alert(1)&gt;"))

# 5. اختبار الأسئلة الشائعة: تهريب السؤال والجواب
دع سؤال_خطر = واجهة_سؤال("<b>سؤال</b>؟"، "<script>bad()</script>")
تحقق(ليس يحتوي(سؤال_خطر، "<script>"))
تحقق(ليس يحتوي(سؤال_خطر، "<b>"))
تحقق(يحتوي(سؤال_خطر، "<details"))

# 6. اختبار باقة الأسعار: رفض javascript: وتهريب المزايا
دع باقة_خطرة = واجهة_باقة(
    "باقة <script>x</script>"،
    "10$"،
    "وصف <img src=x>"،
    ["ميزة <b>آمنة</b>"]،
    "اشترك"،
    "javascript:steal()"
)
تحقق(ليس يحتوي(باقة_خطرة، "<script>"))
تحقق(ليس يحتوي(باقة_خطرة، "javascript:"))
تحقق(يحتوي(باقة_خطرة، "href=\"#\""))

# 7. اختبار شريط التقدم: تهريب العنوان وتقييد النسبة بين 0 و 100
دع تقدم_خطر = واجهة_شريط_تقدم("تقدم\" onmouseover=\"alert(1)"، 180)
تحقق(ليس يحتوي(تقدم_خطر، "\" onmouseover"))
تحقق(يحتوي(تقدم_خطر، "aria-valuenow=\"100\""))

# 8. اختبار التذييل: رفض javascript: وتهريب النص
دع تذييل_خطر = واجهة_تذييل("© <script>x</script>"، [
    ["خبيث"، "javascript:void(0)"]،
    ["بريد"، "mailto:safe@lisan.dev"]
])
تحقق(ليس يحتوي(تذييل_خطر، "<script>"))
تحقق(ليس يحتوي(تذييل_خطر، "javascript:"))
تحقق(يحتوي(تذييل_خطر، "mailto:safe@lisan.dev"))

اطبع("جميع اختبارات أمان lisan-ui 2.0 نجحت بنجاح!")
