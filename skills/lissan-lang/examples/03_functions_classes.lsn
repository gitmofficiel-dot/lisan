# دوال وأصناف
دالة مضروب(ن) {
    إذا (ن <= 1) { أرجع 1 }
    أرجع ن * مضروب(ن - 1)
}
اطبع("مضروب 5 = " + نص(مضروب(5)))

صنف حساب {
    دالة بناء(الرصيد) {
        هذا.الرصيد = الرصيد
    }
    دالة أودع(مبلغ) {
        هذا.الرصيد = هذا.الرصيد + مبلغ
        أرجع هذا.الرصيد
    }
}
دع ح = جديد حساب(100)
اطبع("الرصيد: " + نص(ح.أودع(50)))
